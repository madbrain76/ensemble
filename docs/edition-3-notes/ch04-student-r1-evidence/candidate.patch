+// Each second setting omits a different field. These are real jobs; checking
+// their reports catches a spent limit leaking without inspecting pending state.
+func TestChapter4ChainedLimitsUseFreshDefaults(t *testing.T) {
+	for _, tc := range []struct {
+		name          string
+		first, second map[string]any
+		streamed      string
+		delayed       bool
+	}{
+		{"omitted_cap", map[string]any{"max_output_bytes": 1024}, map[string]any{"ai_callback_delay": 0.3}, "", false},
+		{"omitted_delay", map[string]any{"ai_callback_delay": 0.001}, map[string]any{"max_output_bytes": 2048}, "", true},
+		{"omitted_pattern", map[string]any{"ai_callback_pattern": "MATCH"}, map[string]any{"max_output_bytes": 2048}, "MATCH\n", true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			r, a := jobsAgent(t)
+			name := "read_file"
+			args := map[string]any{"path": "large.txt"}
+			if tc.delayed {
+				name = "finish_later"
+				args = map[string]any{}
+				register(t, a, name, func(ctx ensemble.ToolContext, _ json.RawMessage) (string, error) {
+					if tc.streamed != "" {
+						if _, err := fmt.Fprint(ctx.Job, tc.streamed); err != nil {
+							return "", err
+						}
+					}
+					time.Sleep(150 * time.Millisecond)
+					return "FINISHED", nil
+				})
+			} else if err := os.WriteFile(filepath.Join(a.Config().Workspace, "large.txt"), []byte(strings.Repeat("0123456789", 4096)), 0600); err != nil {
+				t.Fatal(err)
+			}
+			dispatch(t, a, "tool_limits", tc.first)
+			replaced := dispatch(t, a, "tool_limits", tc.second)
+			if !strings.Contains(replaced, "tool_limits consumed by this tool_limits call") {
+				t.Fatalf("missing consumption annotation: %s", replaced)
+			}
+			out := dispatch(t, a, name, args)
+			if !strings.Contains(out, "tool_limits consumed by this "+name+" call") {
+				t.Fatalf("new setting not consumed: %s", out)
+			}
+			if tc.delayed {
+				if jobAt(t, r, 1).Snapshot().Status != "done" || !strings.Contains(out, "FINISHED") {
+					t.Fatalf("omitted field leaked into new setting: %s", out)
+				}
+			} else {
+				if len(out) < 8192 || !strings.Contains(out, "bytes omitted") {
+					t.Fatalf("omitted cap inherited: report bytes=%d; expected default-sized truncated report", len(out))
+				}
+				j := jobAt(t, r, 1)
+				data, err := os.ReadFile(filepath.Join(a.Config().DataDir, j.Snapshot().Output.Locator))
+				if err != nil || len(data) != 40960 {
+					t.Fatalf("persisted file bytes=%d err=%v", len(data), err)
+				}
+			}
+			if out := dispatch(t, a, "list_directory", map[string]any{"path": "."}); strings.Contains(out, "tool_limits consumed") {
+				t.Fatalf("new setting sticky: %s", out)
+			}
+		})
+	}
+}
+
+func TestChapter4ChainedLimitsPrecedenceFailureAndIsolation(t *testing.T) {
+	r, a := jobsAgent(t)
+	if err := os.WriteFile(filepath.Join(a.Config().Workspace, "large.txt"), []byte(strings.Repeat("x", 40960)), 0600); err != nil {
+		t.Fatal(err)
+	}
+	dispatch(t, a, "tool_limits", map[string]any{"max_output_bytes": 1024})
+	dispatch(t, a, "tool_limits", map[string]any{"max_output_bytes": 2048})
+	out := dispatch(t, a, "run_command", map[string]any{"command": "cat large.txt", "max_output_bytes": 8192})
+	if len(out) < 4096 || len(out) > 8400 {
+		t.Fatalf("explicit call cap did not override new setting: bytes=%d", len(out))
+	}
+	dispatch(t, a, "tool_limits", map[string]any{"max_output_bytes": 1024})
+	bad := dispatch(t, a, "tool_limits", map[string]any{"ai_callback_delay": -1})
+	if !strings.Contains(bad, "tool_limits consumed by this tool_limits call") || !strings.Contains(bad, "error:") {
+		t.Fatalf("invalid replacement failed to consume: %s", bad)
+	}
+	out = dispatch(t, a, "read_file", map[string]any{"path": "large.txt"})
+	if strings.Contains(out, "tool_limits consumed") || len(out) < 8192 {
+		t.Fatalf("invalid replacement leaked cap: bytes=%d", len(out))
+	}
+	b, err := r.NewAgent(ensemble.Config{System: "test", MaxTokens: 100, Workspace: a.Config().Workspace, DataDir: t.TempDir(), EnableTools: true})
+	if err != nil {
+		t.Fatal(err)
+	}
+	dispatch(t, a, "tool_limits", map[string]any{"max_output_bytes": 1024})
+	dispatch(t, a, "tool_limits", map[string]any{"ai_callback_delay": 0.001})
+	out = dispatch(t, b, "read_file", map[string]any{"path": "large.txt"})
+	if strings.Contains(out, "tool_limits consumed") || len(out) < 8192 {
+		t.Fatalf("other Agent inherited limits: bytes=%d", len(out))
+	}
+	// A failed registered job must consume this new pending setting as well.
+	register(t, a, "fail_now", func(ensemble.ToolContext, json.RawMessage) (string, error) { return "", fmt.Errorf("expected failure") })
+	out = dispatch(t, a, "fail_now", map[string]any{})
+	if !strings.Contains(out, "tool_limits consumed") {
+		t.Fatalf("registered failure did not consume: %s", out)
+	}
+	out = dispatch(t, a, "list_directory", map[string]any{"path": "."})
+	if strings.Contains(out, "tool_limits consumed") {
+		t.Fatalf("failed registered call retained new pending: %s", out)
+	}
+}
