+package gui
+
+import (
+	"bytes"
+	"encoding/json"
+	"ensemble"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestRetentionSettingsUpdateReconnectRestart(t *testing.T) {
+	for _, raw := range []string{`{"diagnostic_max_records":-1}`, `{"diagnostic_max_records":null}`, `{"diagnostic_max_records":1.5}`, `{"log_mode":""}`, `{"log_mode":"other"}`, `{"log_mode":null}`} {
+		current := defaultSettings(3)
+		got, err := settingsPatch(current, json.RawMessage(raw))
+		if err == nil || got != current {
+			t.Fatal("invalid patch mutated settings", raw, got, err)
+		}
+	}
+	h := fixtureHub(t)
+	path := filepath.Join(t.TempDir(), "settings.json")
+	if err := h.loadSettings(path); err != nil {
+		t.Fatal(err)
+	}
+	p, q := fixturePeer(32), fixturePeer(32)
+	h.subscribe(p)
+	h.subscribe(q)
+	_ = retentionBatch(t, p)
+	_ = retentionBatch(t, q)
+	h.updateSettings(p, json.RawMessage(`{"diagnostic_max_records":0,"log_mode":"dialogue_only"}`))
+	for _, peer := range []*peer{p, q} {
+		m := retentionBatch(t, peer)
+		if m[0]["type"] != "settings_changed" {
+			t.Fatal(m)
+		}
+		s := settingsIn(t, m, "settings_changed")
+		if s.DiagnosticMaxRecords != 0 || s.LogMode != "dialogue_only" {
+			t.Fatal(s)
+		}
+	}
+	want := ensemble.RetentionPolicy{DiagnosticMaxRecords: 0, LogMode: "dialogue_only"}
+	if h.agent.RetentionPolicy() != want {
+		t.Fatal(h.agent.RetentionPolicy())
+	}
+	// Unrelated partial updates retain explicit zero and the selected mode.
+	h.updateSettings(p, json.RawMessage(`{"theme":"light"}`))
+	_ = retentionBatch(t, p)
+	_ = retentionBatch(t, q)
+	fresh := fixturePeer(32)
+	h.subscribe(fresh)
+	m := retentionBatch(t, fresh)
+	s := settingsIn(t, m, "current_settings")
+	if s.DiagnosticMaxRecords != 0 || s.LogMode != "dialogue_only" {
+		t.Fatal(s)
+	}
+	h2 := fixtureHub(t)
+	if err := h2.loadSettings(path); err != nil {
+		t.Fatal(err)
+	}
+	if h2.agent.RetentionPolicy() != want {
+		t.Fatal("restart", h2.agent.RetentionPolicy())
+	}
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var fields map[string]any
+	_ = json.Unmarshal(raw, &fields)
+	if len(fields) != 7 {
+		t.Fatal(string(raw))
+	}
+	before := h.snapshot()
+	h.updateSettings(p, json.RawMessage(`{"log_mode":"bad","theme":"dark"}`))
+	if got := retentionBatch(t, p)[0]["type"]; got != "settings_error" {
+		t.Fatal(got)
+	}
+	after, _ := os.ReadFile(path)
+	if !bytes.Equal(raw, after) || h.snapshot() != before || h.agent.RetentionPolicy() != want {
+		t.Fatal("rejected update published")
+	}
+	h.settingsPath = t.TempDir()
+	h.updateSettings(p, json.RawMessage(`{"diagnostic_max_records":2,"log_mode":"full"}`))
+	if got := retentionBatch(t, p)[0]["type"]; got != "settings_error" {
+		t.Fatal(got)
+	}
+	if h.agent.RetentionPolicy() != want {
+		t.Fatal("failed settings persistence changed runtime policy")
+	}
+}
+func guiDiagnosticCount(t *testing.T, path string) int {
+	t.Helper()
+	b, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
