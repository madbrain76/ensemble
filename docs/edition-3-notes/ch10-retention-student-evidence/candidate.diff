new file mode 100644
index 0000000..525d333
--- /dev/null
+++ b/diagnostics.go
@@ -0,0 +1,189 @@
+package ensemble
+
+import (
+	"bufio"
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"regexp"
+	"sync"
+)
+
+// DiagnosticLog owns one application diagnostic pathname and its append lock.
+// Each Write is one logical record, encoded as a JSON string so embedded newlines
+// cannot be split by retention. The earlier CLI/GUI timestamp and API-prefix
+// formats also have recognized record starts. Unknown legacy bytes remain one
+// indivisible record until the next recognized start, never guessed apart.
+// Only this owner may write/replace the file while open.
+type DiagnosticLog struct {
+	mu   sync.Mutex
+	path string
+	file *os.File
+}
+
+func OpenDiagnosticLog(path string) (*DiagnosticLog, error) {
+	f, err := os.OpenFile(path, os.O_CREATE|os.O_RDWR|os.O_APPEND, 0600)
+	if err != nil {
+		return nil, err
+	}
+	return &DiagnosticLog{path: path, file: f}, nil
+}
+
+// Prior application writers used log.LstdFlags, RFC3339 transport timestamps,
+// and direction-prefixed API frames. Continuation lines belong to that record.
+var legacyDiagnosticStart = regexp.MustCompile(`^(?:[0-9]{4}/[0-9]{2}/[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2} |[0-9]{4}-[0-9]{2}-[0-9]{2}T[^ ]+ (?:in|out) |(?:request|response|error) )`)
+
+type diagnosticRecord struct {
+	Record string `json:"diagnostic_record"`
+}
+
+func (d *DiagnosticLog) Write(p []byte) (int, error) {
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	b, err := json.Marshal(diagnosticRecord{string(p)})
+	if err != nil {
+		return 0, err
+	}
+	// A legacy file may lack its final newline. Separate the first new frame
+	// without pretending that the unterminated legacy record was independently framed.
+	info, err := d.file.Stat()
+	if err != nil {
+		return 0, err
+	}
+	if info.Size() > 0 {
+		var last [1]byte
+		if _, err = d.file.ReadAt(last[:], info.Size()-1); err != nil {
+			return 0, err
+		}
+		if last[0] != '\n' {
+			b = append([]byte{'\n'}, b...)
+		}
+	}
+	b = append(b, '\n')
+	n, err := d.file.Write(b)
+	if err == nil && n != len(b) {
+		err = io.ErrShortWrite
+	}
+	if err != nil {
+		return 0, err
+	}
+	return len(p), nil
+}
+func (d *DiagnosticLog) Close() error { d.mu.Lock(); defer d.mu.Unlock(); return d.file.Close() }
+
+// Retain copies the newest complete records to a sibling, then replaces and
+// switches the live descriptor under the same lock as Write. Until rename
+// succeeds every failure leaves the original bytes and descriptor intact.
+// Scanning tracks offsets only: memory is bounded by one physical line.
+func (d *DiagnosticLog) Retain(maxRecords int) error {
+	if maxRecords < 0 {
+		return fmt.Errorf("diagnostic_max_records must be nonnegative")
+	}
+	if maxRecords == 0 {
+		return nil
+	}
+	d.mu.Lock()
+	defer d.mu.Unlock()
+	info, err := d.file.Stat()
+	if err != nil {
+		return err
+	}
+	scan := func(visit func(int64)) error {
+		r := bufio.NewReader(io.NewSectionReader(d.file, 0, info.Size()))
+		var offset int64
+		legacy := false
+		for {
+			line, err := r.ReadBytes('\n')
+			if len(line) > 0 {
+				var frame map[string]json.RawMessage
+				framed := bytes.HasSuffix(line, []byte{'\n'}) && json.Unmarshal(line, &frame) == nil && len(frame) == 1
+				var text string
+				framed = framed && frame["diagnostic_record"] != nil && json.Unmarshal(frame["diagnostic_record"], &text) == nil
+				if framed || legacyDiagnosticStart.Match(line) || !legacy {
+					visit(offset)
+				}
+				legacy = !framed
+				offset += int64(len(line))
+			}
+			if err == io.EOF {
+				return nil
+			}
+			if err != nil {
+				return err
+			}
+		}
+	}
+	count := 0
+	if err = scan(func(int64) { count++ }); err != nil {
+		return err
+	}
+	if count <= maxRecords {
+		return nil
+	}
+	var start int64
+	index := 0
+	if err = scan(func(offset int64) {
+		if index == count-maxRecords {
+			start = offset
+		}
+		index++
+	}); err != nil {
+		return err
+	}
+	f, err := os.CreateTemp(filepath.Dir(d.path), ".diagnostic-*")
+	if err != nil {
+		return err
+	}
+	name := f.Name()
+	defer os.Remove(name)
+	committed := false
+	defer func() {
+		if !committed {
+			f.Close()
+		}
+	}()
+	if _, err = io.Copy(f, io.NewSectionReader(d.file, start, info.Size()-start)); err != nil {
+		return err
+	}
+	if err = f.Sync(); err != nil {
+		return err
+	}
+	// O_APPEND is unnecessary here: this descriptor is private, remains at EOF,
+	// and all subsequent appends and replacements are serialized by d.mu.
+	if err = os.Rename(name, d.path); err != nil {
+		return err
+	}
+	old := d.file
+	d.file = f
+	committed = true
+	return old.Close()
+}
+
+// ReadRetentionPolicy reads only retention settings from the Chapter 8 file.
+// Decoding onto defaults preserves explicit zero and keeps provider secrets out.
+func ReadRetentionPolicy(path string) (RetentionPolicy, error) {
+	p := DefaultRetentionPolicy()
+	raw, err := os.ReadFile(path)
+	if os.IsNotExist(err) {
+		return p, nil
+	}
+	if err != nil {
+		return p, err
+	}
+	var fields map[string]json.RawMessage
+	if err = json.Unmarshal(raw, &fields); err != nil || fields == nil {
+		return p, fmt.Errorf("settings must be a JSON object")
+	}
+	for _, key := range []string{"diagnostic_max_records", "log_mode"} {
+		if bytes.Equal(bytes.TrimSpace(fields[key]), []byte("null")) {
+			return p, fmt.Errorf("%s cannot be null", key)
+		}
+	}
+	if err = json.Unmarshal(raw, &p); err != nil {
+		return p, err
+	}
+	return p, p.Validate()
+}
