+// ordinary visible text; nested tools and opaque blocks are never traversed.
+func projectDialogue(prior []common.DialogueRecord, events []common.Event) []common.DialogueRecord {
+	records := make(map[uint64]common.DialogueRecord, len(prior))
+	for _, d := range prior {
+		records[d.SourceSeq] = d
+	}
+	for _, e := range events {
+		var role string
+		var parts []common.Part
+		switch e.Type {
+		case "message_received":
+			if e.Message.Actor != "human" {
+				continue
+			}
+			role, parts = "user", e.Message.Parts
+		case "response_ended":
+			role, parts = "assistant", e.Response.Parts
+		default:
+			continue
+		}
+		var text strings.Builder
+		for _, p := range parts {
+			if p.Type == "text" {
+				text.WriteString(p.Text)
+			}
+		}
+		if text.Len() > 0 {
+			records[e.Seq] = common.DialogueRecord{SourceSeq: e.Seq, Role: role, Text: text.String()}
+		}
+	}
+	out := make([]common.DialogueRecord, 0, len(records))
+	for _, d := range records {
+		out = append(out, d)
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].SourceSeq < out[j].SourceSeq })
+	return out
+}
