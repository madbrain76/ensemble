+func TestRetentionGUIActualStartupExitAndZeroRestart(t *testing.T) {
+	persistenceEnv(t)
+	if err := os.MkdirAll("cr", 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile("cr/settings.json", []byte(`{"diagnostic_max_records":3,"log_mode":"dialogue_only"}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	for _, path := range []string{"debug.log", "api.log", "gui.log"} {
+		d, err := ensemble.OpenDiagnosticLog(path)
+		if err != nil {
+			t.Fatal(err)
+		}
+		for i := 0; i < 12; i++ {
+			if _, err = d.Write([]byte("whole\nrecord")); err != nil {
+				t.Fatal(err)
+			}
+		}
+		if err = d.Close(); err != nil {
+			t.Fatal(err)
+		}
+	}
+	var out, errs bytes.Buffer
+	if code := Run([]string{"-port", "0", "-model", "fixture", "-workspace", t.TempDir()}, bytes.NewReader(nil), &out, &errs); code != 0 {
+		t.Fatalf("%d: %s", code, &errs)
+	}
+	for _, path := range []string{"debug.log", "api.log", "gui.log"} {
+		if n := guiDiagnosticCount(t, path); n != 3 {
+			t.Fatalf("%s records %d", path, n)
+		}
+	}
+	b, err := os.ReadFile("save.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var save ensemble.SaveFile
+	if err = json.Unmarshal(b, &save); err != nil {
+		t.Fatal(err)
+	}
+	if save.LogMode != "dialogue_only" || save.Context == nil {
+		t.Fatal(string(b))
+	}
+	if err = os.WriteFile("cr/settings.json", []byte(`{"diagnostic_max_records":0,"log_mode":"full"}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	for _, path := range []string{"debug.log", "api.log", "gui.log"} {
+		d, err := ensemble.OpenDiagnosticLog(path)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err = d.Write([]byte("kept")); err != nil {
+			t.Fatal(err)
+		}
+		_ = d.Close()
+	}
+	if code := Run([]string{"-port", "0", "-model", "fixture", "-workspace", t.TempDir()}, bytes.NewReader(nil), &out, &errs); code != 0 {
+		t.Fatalf("%d: %s", code, &errs)
+	}
+	for _, path := range []string{"debug.log", "api.log", "gui.log"} {
+		if n := guiDiagnosticCount(t, path); n != 4 {
+			t.Fatalf("explicit zero lost on restart %s: %d", path, n)
+		}
+	}
+	b, err = os.ReadFile("save.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	save = ensemble.SaveFile{}
+	if err = json.Unmarshal(b, &save); err != nil {
+		t.Fatal(err)
+	}
+	if save.LogMode != "" && save.LogMode != "full" {
+		t.Fatal(save.LogMode)
+	}
+}
+
+func retentionBatch(t *testing.T, p *peer) []wire {
+	t.Helper()
+	select {
+	case b := <-p.send:
+		return b
+	case <-time.After(2 * time.Second):
+		t.Fatal("settings response timeout")
+		return nil
+	}
+}
