+package main
+
+import (
+	"bytes"
+	"encoding/json"
+	"ensemble"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+func TestRetentionCLISettingsAndRestart(t *testing.T) {
+	t.Chdir(t.TempDir())
+	cliSettings(t)
+	if err := os.MkdirAll("cr", 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile("cr/settings.json", []byte(`{"diagnostic_max_records":2,"log_mode":"dialogue_only"}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	d, err := ensemble.OpenDiagnosticLog("api.log")
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < 8; i++ {
+		if _, err = d.Write([]byte("whole\nrecord")); err != nil {
+			t.Fatal(err)
+		}
+	}
+	_ = d.Close()
+	if err = execute(t, nil, strings.NewReader(""), io.Discard); err != nil {
+		t.Fatal(err)
+	}
+	raw, err := os.ReadFile("api.log")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if bytes.Count(raw, []byte{'\n'}) != 2 {
+		t.Fatal("CLI did not use startup/exit policy", string(raw))
+	}
+	raw, err = os.ReadFile(filepath.Join(filepath.Dir(os.Getenv("CH02_LOG")), "save.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var save ensemble.SaveFile
+	if err = json.Unmarshal(raw, &save); err != nil {
+		t.Fatal(err)
+	}
+	if save.LogMode != "dialogue_only" {
+		t.Fatal(save.LogMode)
+	}
+	if err = os.WriteFile("cr/settings.json", []byte(`{"diagnostic_max_records":0,"log_mode":"full"}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	d, err = ensemble.OpenDiagnosticLog("api.log")
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, err = d.Write([]byte("keep this"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	_ = d.Close()
+	if err = execute(t, nil, strings.NewReader(""), io.Discard); err != nil {
+		t.Fatal(err)
+	}
+	raw, err = os.ReadFile("api.log")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if bytes.Count(raw, []byte{'\n'}) != 3 {
+		t.Fatal("zero lost at restart")
+	}
+	raw, err = os.ReadFile(filepath.Join(filepath.Dir(os.Getenv("CH02_LOG")), "save.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	save = ensemble.SaveFile{}
+	if err = json.Unmarshal(raw, &save); err != nil {
+		t.Fatal(err)
+	}
+	if save.LogMode != "" && save.LogMode != "full" {
+		t.Fatal(save.LogMode)
+	}
+}
