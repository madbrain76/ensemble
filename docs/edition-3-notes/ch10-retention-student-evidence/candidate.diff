+package common
+
+import "fmt"
+
+// RetentionPolicy is runtime policy, not provider configuration or replay state.
+// A nil Config.Retention selects these defaults; an explicit zero is unlimited.
+type RetentionPolicy struct {
+	DiagnosticMaxRecords int    `json:"diagnostic_max_records"`
+	LogMode              string `json:"log_mode"`
+}
+
+func DefaultRetentionPolicy() RetentionPolicy {
+	return RetentionPolicy{DiagnosticMaxRecords: 200, LogMode: "full"}
+}
+
+func (p RetentionPolicy) Validate() error {
+	if p.DiagnosticMaxRecords < 0 {
+		return fmt.Errorf("diagnostic_max_records must be nonnegative")
+	}
+	if p.LogMode != "full" && p.LogMode != "dialogue_only" {
+		return fmt.Errorf("unknown log_mode %q", p.LogMode)
+	}
+	return nil
+}
