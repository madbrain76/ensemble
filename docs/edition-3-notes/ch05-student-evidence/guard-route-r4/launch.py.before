#!/usr/bin/env python3
"""Finite Chapter 5 evidence. --live requires a separately approved checklist.
Identity verification occurs before credential loading or process launch.
"""
import argparse, base64, hashlib, http.server, json, os, pathlib, shutil, struct
import subprocess, tempfile, threading, time, zlib, urllib.request, urllib.error

MODELS = {'anthropic':'claude-sonnet-4-6','openai':'gpt-4.1-2025-04-14','gemini':'gemini-3.8-flash'}

def sha(path): return hashlib.sha256(pathlib.Path(path).read_bytes()).hexdigest()
def save(path, data): pathlib.Path(path).write_text(json.dumps(data,indent=2)+'\n')
def verify(path):
    m=json.loads(pathlib.Path(path).read_text()); root=pathlib.Path(m['source_root'])
    for name,digest in m['source_files'].items():
        if not (root/name).is_file() or sha(root/name)!=digest: raise RuntimeError('source identity refused: '+name)
    if subprocess.check_output(['git','rev-parse','HEAD'],cwd=root,text=True).strip()!=m['source_commit']: raise RuntimeError('source commit refused')
    if subprocess.check_output(['git','status','--porcelain','--untracked-files=normal'],cwd=root,text=True).strip(): raise RuntimeError('source worktree is not clean')
    for name,b in m['binaries'].items():
        if sha(b['path'])!=b['sha256']: raise RuntimeError('binary identity refused: '+name)
    if sha(m['archive']['path'])!=m['archive']['sha256']: raise RuntimeError('source archive identity refused')
    return m

def select_key(settings,vendor):
    field={'anthropic':'directClaudeAPIKey','openai':'directOpenAIAPIKey','gemini':'directGeminiAPIKey'}[vendor]
    value=settings.get(field)
    if not isinstance(value,str) or not value.strip():raise RuntimeError('approved provider credential unavailable (no value printed)')
    return value.strip()

def key_for(vendor):
    # Only called after explicit paid approval and verify(). No fallback sources.
    settings=json.loads((pathlib.Path.home()/'.cr/settings.json').read_text())
    return select_key(settings,vendor)

def environment(vendor,key,base=None):
    # No ambient provider keys reach the executable, much less its shell jobs.
    e={k:os.environ[k] for k in ['PATH','HOME','TMPDIR','LANG','LC_ALL'] if k in os.environ}
    e.update(LLM_VENDOR=vendor,LLM_MODEL=MODELS[vendor],LLM_API_KEY=key,LLM_MAX_TOKENS='1024',LLM_TOOL_BATCH_LIMIT='3',LLM_SYSTEM='Follow the user request precisely. Explain tool intent in visible prose before calls.')
    if base: e['LLM_BASE_URL']=base
    return e

def safe_text(text,key):
    if key and key in text: raise RuntimeError('credential appeared in executable output; raw capture withheld')
    return text

def safe_event(value):
    if isinstance(value,list): return [safe_event(x) for x in value]
    if isinstance(value,dict):
        if value.get('type') in ['thinking','opaque']: return {'type':value['type'],'payload':'omitted'}
        return {k:safe_event(v) for k,v in value.items() if k.lower() not in ['apikey','api_key','signature','thoughtsignature','opaque','thinking']}
    return value

def collect(runtime,out,key):
    files={}
    for p in sorted(runtime.rglob('*')):
        if not p.is_file(): continue
        rel=str(p.relative_to(runtime))
        if p.suffix=='.jsonl':
            rows=[]
            for line in p.read_text().splitlines():
                if line.strip(): rows.append(safe_event(json.loads(line)))
            text=''.join(json.dumps(r,separators=(',',':'))+'\n' for r in rows)
            target=out/(rel+'.safe');target.parent.mkdir(parents=True,exist_ok=True)
            target.write_text(safe_text(text,key));files[rel]={'original_sha256':sha(p),'safe_path':str(target),'safe_sha256':sha(target)}
        elif p.suffix in ['.txt','.json'] or ('cr' in p.parts and 'io' in p.parts):
            try: text=p.read_text()
            except (UnicodeError,OSError): continue
            target=out/rel;target.parent.mkdir(parents=True,exist_ok=True);target.write_text(safe_text(text,key))
            files[rel]={'sha256':sha(target),'path':str(target)}
    return files

def png(path):
    def chunk(kind,data): return struct.pack('!I',len(data))+kind+data+struct.pack('!I',zlib.crc32(kind+data)&0xffffffff)
    rows=b''.join(b'\x00'+b'\xff\x00\x00'*8+b'\x00\x00\xff'*8 for _ in range(8))
    path.write_bytes(b'\x89PNG\r\n\x1a\n'+chunk(b'IHDR',struct.pack('!IIBBBBB',16,8,8,2,0,0,0))+chunk(b'IDAT',zlib.compress(rows))+chunk(b'IEND',b''))

class Fake:
    def __init__(self,scenario,command=''):
        self.scenario=scenario;self.command=command;self.requests=[];self.role_counts={}
        owner=self
        class Handler(http.server.BaseHTTPRequestHandler):
            def log_message(self,*args): pass
            def do_POST(self):
                b=json.loads(self.rfile.read(int(self.headers['Content-Length'])));owner.requests.append(b)
                response=owner.reply(b);raw=json.dumps(response).encode();self.send_response(200);self.send_header('Content-Type','application/json');self.end_headers();self.wfile.write(raw)
        self.server=http.server.ThreadingHTTPServer(('127.0.0.1',0),Handler)
        self.thread=threading.Thread(target=self.server.serve_forever);self.thread.start()
        self.url='http://127.0.0.1:'+str(self.server.server_port)
    def close(self): self.server.shutdown();self.thread.join();self.server.server_close()
    def reply(self,b):
        if self.scenario=='human':
            n=len(self.requests);parts=[{'type':'text','text':{1:'I will start the requested job.',2:'NEW_TURN_OK',3:'I will inspect the retained job.',4:'The real job printed CH05_JOB_FINISHED. RETAINED_INSPECTED'}[n]}]
            if n in [1,3]: parts.append({'type':'tool_use','id':'job' if n==1 else 'inspect','name':'run_command' if n==1 else 'wait_for_job','input':{'command':self.command} if n==1 else {'handle':1}})
            return {'content':parts,'usage':{'input_tokens':10,'output_tokens':10}}
        if self.scenario=='workflow':
            names=[t.get('function',{}).get('name','') for t in b.get('tools',[])];role='author' if 'write_draft' in names else ('editor' if 'edit_draft' in names else 'reviewer')
            n=self.role_counts.get(role,0)+1;self.role_counts[role]=n
            message={'role':'assistant','content':'I will update the shared manuscript.' if n==1 else role+' complete.'}
            calls={'author':[('write_draft',{'text':'A quiet library welcomed the rain.'}),('word_count',{})], 'editor':[('read_draft',{}),('edit_draft',{'text':'Rain whispered against the quiet library windows.'})], 'reviewer':[('review',{'decision':'accept','notes':'Clear prose.'})]}
            if n==1:message['tool_calls']=[{'id':role+str(i),'type':'function','function':{'name':name,'arguments':json.dumps(args)}} for i,(name,args) in enumerate(calls[role])]
            return {'choices':[{'message':message}], 'usage':{'prompt_tokens':10,'completion_tokens':10}}
        if self.scenario=='image':
            encoded=base64.b64encode(self.image_bytes).decode()
            if encoded not in json.dumps(b): raise RuntimeError('renderer omitted actual image bytes')
            return {'candidates':[{'content':{'role':'model','parts':[{'text':'{"left":"red","right":"blue"}'}]}}],'usageMetadata':{'promptTokenCount':10,'candidatesTokenCount':10}}
        if self.scenario=='counter':return {'ok':True}
        raise RuntimeError('unsupported-media check reached HTTP')

# The forwarder never logs auth headers, URL query strings, request or response bodies.
# Its cap is enforced before any upstream connection, independently of model behavior.
BASES={'anthropic':'https://api.anthropic.com','openai':'https://api.openai.com','gemini':'https://generativelanguage.googleapis.com'}
class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self,*args,**kwargs):return None

class Forward:
    def __init__(self,target,limit):
        self.target=target;self.limit=limit;self.attempts=0;self.forwarded=0;self.receipts=[];self.lock=threading.Lock();owner=self
        class Handler(http.server.BaseHTTPRequestHandler):
            def log_message(self,*args):pass
            def do_POST(self):
                body=self.rfile.read(int(self.headers['Content-Length']))
                with owner.lock:
                    owner.attempts+=1;allowed=owner.forwarded<owner.limit
                    if allowed:owner.forwarded+=1
                if not allowed:
                    self.send_response(429);self.end_headers();self.wfile.write(b'{"error":"local evidence request budget exhausted"}');return
                headers={k:v for k,v in self.headers.items() if k.lower() not in ['host','content-length','connection','accept-encoding']}
                request=urllib.request.Request(owner.target+self.path,data=body,headers=headers,method='POST');started=time.monotonic()
                try:
                    with urllib.request.build_opener(urllib.request.ProxyHandler({}),NoRedirect()).open(request,timeout=65) as response:status=response.status;data=response.read()
                except urllib.error.HTTPError as err:status=err.code;data=err.read()
                except Exception:status=502;data=b'{"error":"evidence upstream transport failure"}'
                with owner.lock:owner.receipts.append({'status':status,'elapsed_seconds':time.monotonic()-started,'request_bytes':len(body),'response_bytes':len(data)})
                try:self.send_response(status);self.send_header('Content-Type','application/json');self.end_headers();self.wfile.write(data)
                except (BrokenPipeError,ConnectionResetError):pass
        self.server=http.server.ThreadingHTTPServer(('127.0.0.1',0),Handler);self.thread=threading.Thread(target=self.server.serve_forever);self.thread.start();self.url='http://127.0.0.1:'+str(self.server.server_port)
    def close(self,out):
        self.server.shutdown();self.thread.join();self.server.server_close();out.mkdir(parents=True,exist_ok=True)
        save(out/'request-budget.json',{'limit':self.limit,'attempts':self.attempts,'forwarded':self.forwarded,'receipts':self.receipts})

class Capture:
    def __init__(self,argv,cwd,env,out,key):
        self.start=time.monotonic();self.out=out;self.key=key;self.inputs=[];self.stdout='';self.stderr='';self.lock=threading.Lock()
        self.p=subprocess.Popen(argv,cwd=cwd,env=env,stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True,bufsize=1)
        self.threads=[]
        for stream,name in [(self.p.stdout,'stdout'),(self.p.stderr,'stderr')]:
            def reader(stream=stream,name=name):
                while True:
                    text=stream.read(1)
                    if not text: break
                    with self.lock: setattr(self,name,getattr(self,name)+text)
            t=threading.Thread(target=reader);t.start();self.threads.append(t)
    def send(self,line):
        self.inputs.append({'seconds':time.monotonic()-self.start,'stdin':line});self.p.stdin.write(line+'\n');self.p.stdin.flush()
    def until(self,predicate,seconds,label):
        end=time.monotonic()+seconds
        while not predicate():
            if self.p.poll() is not None: raise RuntimeError('process ended before '+label)
            if time.monotonic()>end: raise RuntimeError('watchdog expired: '+label)
            time.sleep(.01)
        return time.monotonic()-self.start
    def finish(self,timeout):
        if not self.p.stdin.closed: self.p.stdin.close()
        code=self.p.wait(timeout=timeout)
        for t in self.threads:t.join()
        self.persist(code);return code
    def persist(self,code):
        self.out.mkdir(parents=True,exist_ok=True)
        (self.out/'stdout.txt').write_text(safe_text(self.stdout,self.key));(self.out/'stderr.txt').write_text(safe_text(self.stderr,self.key));save(self.out/'inputs.json',self.inputs)
        save(self.out/'process.json',{'exit_code':code,'seconds':time.monotonic()-self.start})
    def abort(self):
        # Only this launcher-owned process; kill is a harness failure, not success.
        if self.p.poll() is None:self.p.terminate()
        try:self.p.wait(timeout=5)
        except subprocess.TimeoutExpired:self.p.kill();self.p.wait()
        for t in self.threads:t.join()
        self.persist(self.p.returncode)

def human(m,out,live):
    key=key_for('anthropic') if live else 'local-fixture-key';fake=None;capture=None;forward=None
    with tempfile.TemporaryDirectory(prefix='cadence-ch05-runtime-human-') as temp:
        runtime=pathlib.Path(temp);duration=20 if live else 2
        command="if [ -n \"${LLM_API_KEY-}\" ]; then printf 'KEY_ENV_LEAK\\n'; exit 3; fi; printf 'CH05_JOB_STARTED\\n'; sleep "+str(duration)+"; printf 'CH05_JOB_FINISHED\\n' > retained.txt; cat retained.txt"
        if not live:fake=Fake('human',command)
        forward=Forward(BASES['anthropic'] if live else fake.url,8)
        try:
            capture=Capture([m['binaries']['cli']['path'],'chat'],runtime,environment('anthropic',key,forward.url),out,key)
            capture.send('Run exactly this shell command with run_command (not a simulated job): '+command+' . Do not wait with a second tool; I will interrupt the turn after it starts.')
            def started():
                return any(p.is_file() and b'CH05_JOB_STARTED' in p.read_bytes() for p in runtime.rglob('*') if 'cr' in p.parts and 'io' in p.parts)
            times={'job_started':capture.until(started,40,'real job START')}
            capture.send('/hint use concise prose')
            times['hint_ack']=capture.until(lambda:'Hint:' in capture.stderr and 'use concise prose' in capture.stderr,4,'hint acknowledgement')
            if (runtime/'retained.txt').exists():raise RuntimeError('old job finished before hint/interrupt')
            capture.send('/interrupt')
            times['interrupt_reply']=capture.until(lambda:'Interrupted; ready for another prompt.' in capture.stderr,5,'reliable interruption reply')
            capture.send('For this new turn do not wait for or inspect the old job. Reply briefly with NEW_TURN_OK.')
            times['new_turn_reply']=capture.until(lambda:'NEW_TURN_OK' in capture.stdout,35,'reliable new-turn answer')
            if (runtime/'retained.txt').exists():raise RuntimeError('new-turn answer was not observed before old job completion')
            times['old_job_finished']=capture.until(lambda:(runtime/'retained.txt').exists(),35,'retained real FINISHED side effect')
            capture.send('Use wait_for_job on handle 1 to inspect its retained terminal output. Report the real output and conclude with RETAINED_INSPECTED.')
            times['inspection_reply']=capture.until(lambda:'RETAINED_INSPECTED' in capture.stdout,35,'post-completion retained-output inspection')
            if capture.finish(15)!=0:raise RuntimeError('human CLI exit was not zero')
            events=[json.loads(x) for x in (runtime/'ch02.jsonl').read_text().splitlines() if x.strip()]
            results=[e.get('tool',{}) for e in events if e.get('type')=='tool_returned']
            if not any(r.get('name')=='wait_for_job' and not r.get('is_error') and 'CH05_JOB_FINISHED' in json.dumps(r.get('parts',[])) for r in results):raise RuntimeError('actual retained-output tool result missing')
            files=collect(runtime,out,key)
            if 'KEY_ENV_LEAK' in capture.stdout:raise RuntimeError('key environment reached process job')
            save(out/'result.json',{'passed':True,'live':live,'vendor':'anthropic','model':MODELS['anthropic'],'ordering':times,'retained_file':(runtime/'retained.txt').read_text(),'files':files,'fake_requests':len(fake.requests) if fake else None})
        except BaseException:
            if capture:capture.abort();collect(runtime,out,key)
            raise
        finally:
            forward.close(out)
            if fake:fake.close()

def validate_workflow(runtime,rows):
    kinds=[r.get('pipeline') for r in rows]
    for kind in ['author_done','editor_done','reviewer_done']:
        if kind not in kinds:raise RuntimeError('missing pipeline marker: '+kind)
    if not (kinds.index('author_done')<kinds.index('editor_done')<kinds.index('reviewer_done')):raise RuntimeError('handoffs out of order')
    calls={(r.get('agent'),r['part'].get('call_id')):r['part'] for r in rows if r.get('part',{}).get('type')=='tool_call'}
    results={}
    for r in rows:
        part=r.get('part',{})
        if part.get('type')!='tool_result' or part.get('is_error'):continue
        call=calls.get((r.get('agent'),part.get('call_id')))
        if not call or call.get('name')!=part.get('name'):raise RuntimeError('uncorrelated workflow tool result')
        results.setdefault((r.get('agent'),part.get('name')),[]).append((call.get('args',{}),part))
    expected={'write_draft':'author','word_count':'author','read_draft':'editor','edit_draft':'editor','review':'reviewer'}
    for name,role in expected.items():
        if not results.get((role,name)):raise RuntimeError('missing successful role tool: '+name)
    authored=results[('author','write_draft')][-1][0].get('text')
    edited=results[('editor','edit_draft')][-1][0].get('text')
    review=results[('reviewer','review')][-1][0]
    if not isinstance(authored,str) or not authored.strip():raise RuntimeError('empty authored manuscript')
    if not isinstance(edited,str) or not edited.strip():raise RuntimeError('empty edited manuscript')
    if authored.strip()==edited.strip():raise RuntimeError('editor did not change manuscript')
    texts=lambda part:''.join(p.get('text','') for p in part.get('parts',[]) if p.get('type')=='text')
    if not any(texts(part)==authored for _,part in results[('editor','read_draft')]):raise RuntimeError('editor did not receive authored text')
    count=texts(results[('author','word_count')][-1][1]).strip()
    if count!=str(len(authored.split())):raise RuntimeError('word_count differs from authored manuscript')
    if review.get('decision') not in ['accept','reject'] or not isinstance(review.get('notes'),str) or not review['notes'].strip():raise RuntimeError('review lacks decision or substantive notes')
    if json.loads(texts(results[('reviewer','review')][-1][1]))!=review:raise RuntimeError('review result differs from actual call')
    if not (runtime/'manuscript.txt').is_file() or not (runtime/'review.json').is_file():raise RuntimeError('role file effects missing')
    if (runtime/'manuscript.txt').read_text()!=edited:raise RuntimeError('edited file differs from actual tool arguments')
    if json.loads((runtime/'review.json').read_text())!=review:raise RuntimeError('review file differs from actual tool arguments')
    return {'authored_words':len(authored.split()),'edited_words':len(edited.split()),'changed':True,'review_decision':review['decision'],'correlated_tools':list(expected)}

def validate_image(stdout):
    replies=[json.loads(x).get('assistant','') for x in stdout.splitlines() if x.strip()]
    answer=''.join(replies).strip()
    if answer.startswith('```'):answer=answer.split('\n',1)[1].rsplit('```',1)[0].strip()
    arrangement=json.loads(answer)
    if arrangement!={'left':'red','right':'blue'}:raise RuntimeError('image arrangement not correctly recognized')
    return arrangement

def workflow(m,out,live):
    key=key_for('openai') if live else 'local-fixture-key';fake=Fake('workflow') if not live else None;capture=None;forward=Forward(BASES['openai'] if live else fake.url,12)
    with tempfile.TemporaryDirectory(prefix='cadence-ch05-runtime-workflow-') as temp:
        runtime=pathlib.Path(temp)
        try:
            capture=Capture([m['binaries']['workflow']['path']],runtime,environment('openai',key,forward.url),out,key)
            capture.send(json.dumps({'kind':'prompt','text':'Write roughly 80 words of vivid prose about a rainy library. Author must write_draft and word_count; editor must read_draft and edit_draft; reviewer must review with accept/reject and short notes.'}))
            if capture.finish(120)!=0:raise RuntimeError('workflow failed')
            rows=[json.loads(x) for x in capture.stdout.splitlines() if x.strip()]
            proof=validate_workflow(runtime,rows)
            files=collect(runtime,out,key);save(out/'result.json',{'passed':True,'live':live,'vendor':'openai','model':MODELS['openai'],'proof':proof,'files':files,'fake_requests':len(fake.requests) if fake else None})
        except BaseException:
            if capture:capture.abort();collect(runtime,out,key)
            raise
        finally:
            forward.close(out)
            if fake:fake.close()

def image(m,out,live):
    key=key_for('gemini') if live else 'local-fixture-key';fake=Fake('image') if not live else None;capture=None;forward=Forward(BASES['gemini'] if live else fake.url,1)
    with tempfile.TemporaryDirectory(prefix='cadence-ch05-runtime-image-') as temp:
        runtime=pathlib.Path(temp);path=runtime/'fixture.png';png(path)
        if fake:fake.image_bytes=path.read_bytes()
        try:
            capture=Capture([m['binaries']['cli']['path']],runtime,environment('gemini',key,forward.url),out,key)
            capture.send(json.dumps({'parts':[{'type':'text','text':'Describe the two regions as JSON with keys left and right and their color names. No extra prose.'},{'type':'blob','mime':'image/png','ref':{'kind':1,'locator':str(path)}}]}))
            if capture.finish(60)!=0:raise RuntimeError('image CLI failed')
            arrangement=validate_image(capture.stdout)
            encoded=base64.b64encode(path.read_bytes())
            for h in runtime.rglob('*.jsonl'):
                if encoded in h.read_bytes():raise RuntimeError('history contains image bytes')
            out.mkdir(parents=True,exist_ok=True);shutil.copy2(path,out/'fixture.png');files=collect(runtime,out,key)
            save(out/'result.json',{'passed':True,'live':live,'vendor':'gemini','model':MODELS['gemini'],'arrangement':arrangement,'image_sha256':sha(path),'files':files,'fake_requests':len(fake.requests) if fake else None})
        except BaseException:
            if capture:capture.abort();collect(runtime,out,key)
            raise
        finally:
            forward.close(out)
            if fake:fake.close()

def unsupported(m,out):
    fake=Fake('unsupported');key='local-fixture-key';capture=None
    with tempfile.TemporaryDirectory(prefix='cadence-ch05-runtime-unsupported-') as temp:
        runtime=pathlib.Path(temp);path=runtime/'unsupported.mp4';path.write_bytes(b'local unsupported-video fixture')
        try:
            capture=Capture([m['binaries']['cli']['path']],runtime,environment('anthropic',key,fake.url),out,key)
            capture.send(json.dumps({'parts':[{'type':'text','text':'Summarize this video.'},{'type':'blob','mime':'video/mp4','ref':{'kind':1,'locator':str(path)}}]}))
            code=capture.finish(15)
            if code==0 or fake.requests or 'video' not in capture.stderr or MODELS['anthropic'] not in capture.stderr:raise RuntimeError('unsupported media did not refuse before HTTP')
            save(out/'result.json',{'passed':True,'live':False,'exit_code':code,'http_requests':len(fake.requests),'files':collect(runtime,out,key)})
        finally:
            if capture and capture.p.poll() is None:capture.abort()
            fake.close()

def main():
    p=argparse.ArgumentParser();p.add_argument('--manifest',required=True);p.add_argument('--out');p.add_argument('--verify-only',action='store_true');p.add_argument('--live',action='store_true');p.add_argument('--scenario',choices=['human','workflow','image','unsupported','all'],default='all');a=p.parse_args()
    m=verify(a.manifest)
    if a.verify_only:print('identity verified; no credentials loaded or process launched');return
    if not a.out:raise RuntimeError('--out required')
    out=pathlib.Path(a.out)
    if out.exists():raise RuntimeError('refusing to overwrite evidence directory')
    out.mkdir(parents=True)
    save(out/'invocation.json',{'manifest_path':a.manifest,'manifest_sha256':sha(a.manifest),'source_commit':m['source_commit'],'binaries':m['binaries'],'live':a.live,'scenario':a.scenario,'tool_batch_limit':3,'max_tokens':1024})
    try:
        for name,fn in [('human',human),('workflow',workflow),('image',image),('unsupported',unsupported)]:
            if a.scenario not in ['all',name]:continue
            verify(a.manifest)
            if name=='unsupported':fn(m,out/name)
            else:fn(m,out/name,a.live)
        save(out/'summary.json',{'passed':True,'live':a.live,'scenario':a.scenario})
    except BaseException as err:
        # Error messages are deliberately our own labels, never HTTP bodies/keys.
        save(out/'summary.json',{'passed':False,'live':a.live,'error':str(err)})
        raise
    finally:
        save(out/'artifact-manifest.json',{str(f.relative_to(out)):sha(f) for f in sorted(out.rglob('*')) if f.is_file() and f.name!='artifact-manifest.json'})
if __name__=='__main__':
    try:main()
    except Exception as err:print(type(err).__name__+': '+str(err));raise SystemExit(2)
