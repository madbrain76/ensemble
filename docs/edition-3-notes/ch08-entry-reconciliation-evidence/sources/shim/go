#!/usr/bin/python3
import os,sys,subprocess,hashlib,json,time
args=sys.argv[1:];started=time.time();rc=subprocess.call(['/usr/local/go/bin/go']+args)
if args and args[0]=='build':
 record={'stage':os.environ.get('AUDIT_STAGE'),'cwd':os.getcwd(),'argv':['/usr/local/go/bin/go']+args,'exit':rc,'seconds':round(time.time()-started,3)}
 if '-o' in args:
  p=os.path.abspath(args[args.index('-o')+1]);record['output']=p
  if rc==0 and os.path.isfile(p):
   with open(p,'rb') as f:b=f.read()
   record.update(bytes=len(b),sha256=hashlib.sha256(b).hexdigest())
   if os.environ.get('AUDIT_STAGE','').startswith('settings-'):
    import shutil
    retained=os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))),'bin',os.environ['AUDIT_STAGE']+'-gui')
    shutil.copy2(p,retained);record['retained_local_binary']=retained
 with open(os.environ['AUDIT_BUILD_LOG'],'a') as f:f.write(json.dumps(record)+'\n')
sys.exit(rc)
