diff --git a/gui/settings.go b/gui/settings.go
new file mode 100644
index 0000000..ef016f6
--- /dev/null
+++ b/gui/settings.go
@@ -0,0 +1,121 @@
+package gui
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+)
+
+// Settings is a GUI snapshot. False/zero are significant wire values.
+// MaxToolRounds persists the Agent's next-turn policy, not an active turn's allowance.
+type Settings struct {
+	Theme         string  `json:"theme"`
+	TTSEnabled    bool    `json:"tts_enabled"`
+	TTSSpeed      float64 `json:"tts_speed"`
+	FontSize      int     `json:"font_size"`
+	MaxToolRounds int     `json:"max_tool_rounds"`
+}
+
+func defaultSettings(limit int) Settings { return Settings{"dark", true, 1, 16, limit} }
+
+// Decode onto a copy: a late type error cannot partially change live state.
+// The same validator handles patches and saved settings.
+func settingsPatch(current Settings, raw json.RawMessage) (Settings, error) {
+	raw = bytes.TrimSpace(raw)
+	if len(raw) == 0 || raw[0] != '{' {
+		return current, fmt.Errorf("settings must be a JSON object")
+	}
+	next := current
+	if err := json.Unmarshal(raw, &next); err != nil {
+		return current, fmt.Errorf("invalid settings: %w", err)
+	}
+	// JSON null is not a value for any of these scalar preferences.
+	var fields map[string]json.RawMessage
+	if err := json.Unmarshal(raw, &fields); err != nil {
+		return current, err
+	}
+	for _, key := range []string{"theme", "tts_enabled", "tts_speed", "font_size", "max_tool_rounds"} {
+		if bytes.Equal(bytes.TrimSpace(fields[key]), []byte("null")) {
+			return current, fmt.Errorf("%s cannot be null", key)
+		}
+	}
+	switch next.Theme {
+	case "dark", "light", "system":
+	default:
+		next.Theme = "dark"
+	}
+	next.TTSSpeed = max(0.5, min(5, next.TTSSpeed))
+	next.FontSize = max(12, min(24, next.FontSize))
+	next.MaxToolRounds = max(0, next.MaxToolRounds)
+	return next, nil
+}
+func saveSettings(path string, value Settings) error {
+	data, err := json.MarshalIndent(value, "", "  ")
+	if err != nil {
+		return err
+	}
+	if err = os.MkdirAll(filepath.Dir(path), 0700); err != nil {
+		return err
+	}
+	f, err := os.CreateTemp(filepath.Dir(path), ".settings-*")
+	if err != nil {
+		return err
+	}
+	defer os.Remove(f.Name()) // only this operation's uncommitted replacement
+	if _, err = f.Write(append(data, '\n')); err != nil {
+		f.Close()
+		return err
+	}
+	if err = f.Close(); err != nil {
+		return err
+	}
+	return os.Rename(f.Name(), path)
+}
+
+// loadSettings runs at the application boundary, before serving either view.
+func (h *hub) loadSettings(path string) error {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	next := h.snapshot()
+	raw, err := os.ReadFile(path)
+	if err != nil && !os.IsNotExist(err) {
+		return err
+	}
+	if err == nil {
+		next, err = settingsPatch(next, raw)
+		if err != nil {
+			return err
+		}
+	}
+	if err = h.agent.SetToolBatchLimit(next.MaxToolRounds); err != nil {
+		return err
+	}
+	h.settings, h.settingsPath = next, path
+	return nil
+}
+
+// snapshot is called under the hub lock. The Agent is authoritative for budget.
+func (h *hub) snapshot() Settings {
+	value := h.settings
+	value.MaxToolRounds = h.agent.ToolBatchLimit()
+	return value
+}
+func (h *hub) updateSettings(p *peer, raw json.RawMessage) {
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	next, err := settingsPatch(h.snapshot(), raw)
+	if err == nil {
+		err = saveSettings(h.settingsPath, next)
+	}
+	if err == nil {
+		err = h.agent.SetToolBatchLimit(next.MaxToolRounds)
+	}
+	if err != nil {
+		h.offer(p, []wire{{"type": "settings_error", "text": err.Error()}})
+		return
+	}
+	h.settings = next
+	h.broadcast([]wire{{"type": "settings_changed", "settings": h.snapshot()}})
+}
diff --git a/gui/settings_test.go b/gui/settings_test.go
new file mode 100644
index 0000000..f06d839
--- /dev/null
+++ b/gui/settings_test.go
@@ -0,0 +1,195 @@
+package gui
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"testing"
+)
+
+func TestSettingsPatchAndLoad(t *testing.T) {
+	base := defaultSettings(7)
+	for _, tc := range []struct {
+		name, raw string
+		want      Settings
+		bad       bool
+	}{
+		{"absent", `{}`, base, false},
+		{"false-zero", `{"tts_enabled":false,"max_tool_rounds":0}`, Settings{"dark", false, 1, 16, 0}, false},
+		{"fractional", `{"theme":"light","tts_speed":1.2345,"font_size":18,"max_tool_rounds":2}`, Settings{"light", true, 1.2345, 18, 2}, false},
+		{"normalize", `{"theme":"other","tts_speed":9,"font_size":1,"max_tool_rounds":-5}`, Settings{"dark", true, 5, 12, 0}, false},
+		{"system-low", `{"theme":"system","tts_speed":0.1,"font_size":100}`, Settings{"system", true, 0.5, 24, 7}, false},
+		{"late-type", `{"theme":"light","tts_enabled":"false"}`, base, true},
+		{"null", `{"font_size":null}`, base, true}, {"array", `[]`, base, true}, {"nil", `null`, base, true}, {"malformed", `{`, base, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := settingsPatch(base, []byte(tc.raw))
+			if (err != nil) != tc.bad || got != tc.want {
+				t.Fatalf("got %+v err=%v want %+v bad=%t", got, err, tc.want, tc.bad)
+			}
+		})
+	}
+	path := filepath.Join(t.TempDir(), "cr", "settings.json")
+	h := fixtureHub(t)
+	if err := h.loadSettings(path); err != nil {
+		t.Fatal(err)
+	}
+	if h.snapshot() != defaultSettings(0) {
+		t.Fatal(h.snapshot())
+	}
+	if err := os.MkdirAll(filepath.Dir(path), 0700); err != nil {
+		t.Fatal(err)
+	}
+	for _, raw := range []string{`{"theme":"other","max_tool_rounds":-9,"tts_speed":0.1,"font_size":90}`, `{"theme":"light","tts_speed":1.75,"max_tool_rounds":2}`} {
+		if err := os.WriteFile(path, []byte(raw), 0600); err != nil {
+			t.Fatal(err)
+		}
+		want, err := settingsPatch(h.snapshot(), []byte(raw))
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err = h.loadSettings(path); err != nil {
+			t.Fatal(err)
+		}
+		if h.snapshot() != want || h.agent.ToolBatchLimit() != want.MaxToolRounds {
+			t.Fatal("disk bypassed shared validator", h.snapshot())
+		}
+	}
+	before := h.snapshot()
+	if err := os.WriteFile(path, []byte(`{"theme":"light","font_size":"bad"}`), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := h.loadSettings(path); err == nil || h.snapshot() != before {
+		t.Fatal("invalid disk state accepted")
+	}
+	if err := h.loadSettings(filepath.Dir(path)); err == nil {
+		t.Fatal("unreadable file accepted")
+	}
+}
+func settingsIn(t *testing.T, batch []wire, kind string) Settings {
+	t.Helper()
+	for _, m := range batch {
+		if m["type"] == kind {
+			b, _ := json.Marshal(m["settings"])
+			var s Settings
+			if err := json.Unmarshal(b, &s); err != nil {
+				t.Fatal(err)
+			}
+			var fields map[string]any
+			json.Unmarshal(b, &fields)
+			if len(fields) != 5 {
+				t.Fatalf("partial snapshot %s", b)
+			}
+			return s
+		}
+	}
+	t.Fatalf("missing %s: %v", kind, batch)
+	return Settings{}
+}
+func TestSettingsCommitBroadcastRestartAndFailure(t *testing.T) {
+	h := fixtureHub(t)
+	path := filepath.Join(t.TempDir(), "cr", "settings.json")
+	if err := h.loadSettings(path); err != nil {
+		t.Fatal(err)
+	}
+	p, q := fixturePeer(32), fixturePeer(32)
+	h.subscribe(p)
+	h.subscribe(q)
+	settingsIn(t, <-p.send, "current_settings")
+	<-q.send
+	patch := json.RawMessage(`{"theme":"light","tts_enabled":false,"tts_speed":1.2345,"font_size":18,"max_tool_rounds":2}`)
+	h.updateSettings(p, patch)
+	want := Settings{"light", false, 1.2345, 18, 2}
+	for _, peer := range []*peer{p, q} {
+		if got := settingsIn(t, <-peer.send, "settings_changed"); got != want {
+			t.Fatal(got)
+		}
+	}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(data), `"tts_enabled": false`) {
+		t.Fatal("false omitted from persistence")
+	}
+	var disk Settings
+	if err = json.Unmarshal(data, &disk); err != nil || disk != want {
+		t.Fatal("published before accepted persistence", disk, err)
+	}
+	fresh := fixturePeer(32)
+	h.subscribe(fresh)
+	if got := settingsIn(t, <-fresh.send, "current_settings"); got != want {
+		t.Fatal(got)
+	}
+	restored := fixtureHub(t)
+	if err = restored.loadSettings(path); err != nil {
+		t.Fatal(err)
+	}
+	if restored.snapshot() != want || restored.agent.ToolBatchLimit() != 2 {
+		t.Fatal("not restored", restored.snapshot())
+	}
+	// Force a real rename failure: target is a directory, even for privileged users.
+	blocked := filepath.Join(filepath.Dir(path), "blocked")
+	if err = os.Mkdir(blocked, 0700); err != nil {
+		t.Fatal(err)
+	}
+	h.settingsPath = blocked
+	h.updateSettings(p, json.RawMessage(`{"theme":"dark","max_tool_rounds":18}`))
+	if batch := <-p.send; len(batch) != 1 || batch[0]["type"] != "settings_error" {
+		t.Fatal("missing save error", batch)
+	}
+	if len(q.send) != 0 || len(fresh.send) != 0 || h.snapshot() != want || h.agent.ToolBatchLimit() != 2 {
+		t.Fatal("failed save mutated or broadcast")
+	}
+	after, _ := os.ReadFile(path)
+	if string(after) != string(data) {
+		t.Fatal("accepted file changed")
+	}
+	leftovers, _ := filepath.Glob(filepath.Join(filepath.Dir(path), ".settings-*"))
+	if len(leftovers) != 0 {
+		t.Fatal("leaked replacement", leftovers)
+	}
+	// File-as-parent failure and malformed patch likewise leave the accepted value.
+	h.settingsPath = filepath.Join(path, "child")
+	h.updateSettings(p, patch)
+	if (<-p.send)[0]["type"] != "settings_error" {
+		t.Fatal("parent error lost")
+	}
+	h.settingsPath = path
+	h.updateSettings(p, json.RawMessage(`{"theme":"dark","font_size":"bad"}`))
+	if (<-p.send)[0]["type"] != "settings_error" || h.snapshot() != want {
+		t.Fatal("partial invalid patch")
+	}
+	h.updateSettings(p, json.RawMessage(`{"tts_enabled":false,"max_tool_rounds":0}`))
+	want.MaxToolRounds = 0
+	if got := settingsIn(t, <-p.send, "settings_changed"); got != want {
+		t.Fatal("recovery/explicit zero", got)
+	}
+}
+func TestSettingsConcurrentPatchSubscribe(t *testing.T) {
+	h := fixtureHub(t)
+	if err := h.loadSettings(filepath.Join(t.TempDir(), "settings.json")); err != nil {
+		t.Fatal(err)
+	}
+	var wg sync.WaitGroup
+	for i := 0; i < 12; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			p := fixturePeer(128)
+			h.subscribe(p)
+			settingsIn(t, <-p.send, "current_settings")
+			if i%2 == 0 {
+				h.updateSettings(p, json.RawMessage(`{"theme":"light"}`))
+			} else {
+				h.updateSettings(p, json.RawMessage(`{"font_size":19}`))
+			}
+		}(i)
+	}
+	wg.Wait()
+	if got := h.snapshot(); got.Theme != "light" || got.FontSize != 19 {
+		t.Fatal("lost disjoint patch", got)
+	}
+}
