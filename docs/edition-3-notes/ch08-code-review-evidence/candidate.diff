+++ b/gui/web/gui/workbench.js
@@ -0,0 +1,79 @@
+// Layout only: the hub/Agent retain all conversation and model ownership.
+export function setupWorkbench(send) {
+ const $ = id => document.getElementById(id);
+ const media = window.matchMedia('(prefers-color-scheme: dark)');
+ let accepted = null;
+ const controls = {theme:$('theme'), tts_enabled:$('read-aloud'), tts_speed:$('tts-speed'), font_size:$('font-size')};
+ function paint() {
+  if (!accepted) return;
+  const s = accepted;
+  document.documentElement.dataset.theme = s.theme === 'system' ? (media.matches ? 'dark' : 'light') : s.theme;
+  document.documentElement.style.setProperty('--font-size', `${s.font_size}px`);
+  controls.theme.value=s.theme; controls.tts_enabled.checked=s.tts_enabled;
+  controls.tts_enabled.setAttribute('aria-checked',String(s.tts_enabled));
+  controls.tts_speed.value=String(s.tts_speed); controls.font_size.value=String(s.font_size);
+  $('speed-value').textContent=`${s.tts_speed}×${s.tts_speed>2?' (approx.)':''}`;
+  $('font-value').textContent=`${s.font_size} px`;
+ }
+ media.addEventListener('change',paint);
+ for (const [key, control] of Object.entries(controls)) {
+  control.disabled=true;
+  control.addEventListener('change',()=>{
+   const value=key==='tts_enabled'?control.checked:key==='theme'?control.value:Number(control.value);
+   send({type:'update_settings', settings:{[key]:value}});
+   // A local draft is not an accepted server snapshot.
+   paint();
+  });
+ }
+ const tabs=['agents','settings'];
+ function selectTab(name, focus=false) {
+  for (const tab of tabs) {
+   const selected=tab===name, button=$(`${tab}-tab`);
+   button.setAttribute('aria-selected',String(selected)); button.tabIndex=selected?0:-1;
+   $(`${tab}-panel`).hidden=!selected;
+   if(selected && focus) button.focus();
+  }
+ }
+ for(const tab of tabs) {
+  $(`${tab}-tab`).onclick=()=>selectTab(tab);
+  $(`${tab}-tab`).onkeydown=e=>{
+   if(['ArrowLeft','ArrowRight','Home','End'].includes(e.key)) {
+    e.preventDefault(); selectTab(e.key==='Home'?'agents':e.key==='End'?'settings':tabs.find(t=>t!==tab),true);
+   }
+  };
+ }
+ function tree(node) {
+  const row=document.createElement('div'); row.className='agent-node'; row.dataset.state=node.state;
+  const label=document.createElement('div'); label.className='agent-name';
+  const dot=document.createElement('span'); dot.className='agent-dot'; dot.setAttribute('aria-hidden','true');
+  const name=document.createElement('strong'); name.textContent=node.name;
+  label.append(dot,name); row.append(label);
+  const state=document.createElement('div'); state.className='agent-state'; state.textContent=node.state; row.append(state);
+  if(node.children?.length) { const children=document.createElement('div'); children.className='agent-children'; for(const child of node.children) children.append(tree(child)); row.append(children); }
+  return row;
+ }
+ let agentID='root';
+ function state(value) { if(value.agent) agentID=value.agent; $('agent-tree').replaceChildren(tree({name:agentID,state:value.state||'idle',children:[]})); }
+ state({state:'idle'});
+ const workbench=$('workbench');
+ function divider(id, property, side, minimum, other) {
+  const bar=$(id); let origin=0, width=0;
+  const read=()=>parseFloat(getComputedStyle(document.documentElement).getPropertyValue(property));
+  const limit=()=>Math.max(minimum,Math.min(480,workbench.getBoundingClientRect().width-parseFloat(getComputedStyle(document.documentElement).getPropertyValue(other))-272));
+  const set=value=>{const upper=limit(), actual=Math.max(minimum,Math.min(upper,value)); document.documentElement.style.setProperty(property,`${actual}px`); bar.setAttribute('aria-valuenow',String(Math.round(actual))); bar.setAttribute('aria-valuemax',String(Math.round(upper)));};
+  bar.onpointerdown=e=>{if(e.button!==0)return;origin=e.clientX;width=read();bar.setPointerCapture(e.pointerId);};
+  bar.onpointermove=e=>{if(bar.hasPointerCapture(e.pointerId))set(width+side*(e.clientX-origin));};
+  bar.onpointerup=e=>{if(bar.hasPointerCapture(e.pointerId))bar.releasePointerCapture(e.pointerId);};
+  bar.onpointercancel=e=>{if(bar.hasPointerCapture(e.pointerId))bar.releasePointerCapture(e.pointerId);};
+  bar.onkeydown=e=>{if(!['ArrowLeft','ArrowRight','Home','End'].includes(e.key))return;e.preventDefault();set(e.key==='Home'?minimum:e.key==='End'?limit():read()+(e.key==='ArrowRight'?1:-1)*side*(e.shiftKey?40:10));};
+  window.addEventListener('resize',()=>set(read())); set(read());
+ }
+ divider('sidebar-divider','--sidebar-width',1,140,'--actions-width');
+ divider('actions-divider','--actions-width',-1,180,'--sidebar-width');
+ return {
+  apply(settings) {accepted={...settings};for(const control of Object.values(controls)) control.disabled=false;$('settings-error').textContent='';paint();},
+  error(text) {$('settings-error').textContent=text;selectTab('settings');paint();},
+  state,
+  get speed(){return accepted?.tts_speed??1;}
+ };
+}
