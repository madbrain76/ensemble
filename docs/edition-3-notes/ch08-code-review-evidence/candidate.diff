+++ b/chapter8_budget_test.go
@@ -0,0 +1,110 @@
+package ensemble_test
+
+import (
+	"context"
+	"encoding/json"
+	"ensemble"
+	"errors"
+	"fmt"
+	"io"
+	"log"
+	"net/http"
+	"net/http/httptest"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+func TestChapter8NextTurnBudget(t *testing.T) {
+	held, release := releaseOnce()
+	defer release()
+	entered := make(chan struct{})
+	var requests atomic.Int32
+	var wanted atomic.Int32
+	wanted.Store(20)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		n := requests.Add(1)
+		if n == 1 {
+			close(entered)
+			select {
+			case <-held:
+			case <-r.Context().Done():
+				return
+			}
+		}
+		content := []any{map[string]any{"type": "text", "text": "Done."}}
+		if n <= wanted.Load() {
+			content = []any{map[string]any{"type": "text", "text": "I will update the local tool observation limits."}, map[string]any{"type": "tool_use", "id": fmt.Sprint("call", n), "name": "tool_limits", "input": map[string]any{"ai_callback_delay": 0.01, "max_output_bytes": 1024}}}
+		}
+		w.Header().Set("Content-Type", "application/json")
+		json.NewEncoder(w).Encode(map[string]any{"id": "fixture", "type": "message", "role": "assistant", "model": "claude-sonnet-4-6", "content": content, "stop_reason": "end_turn", "usage": map[string]int{"input_tokens": 1, "output_tokens": 1}})
+	}))
+	defer server.Close()
+	root := ensemble.New(log.New(io.Discard, "", 0))
+	defer root.Shutdown()
+	a, err := root.NewAgent(ensemble.Config{Vendor: ensemble.Anthropic, Model: "claude-sonnet-4-6", APIKey: "local-fixture-only", BaseURL: server.URL, System: "Explain tool batches.", MaxTokens: 1024, EnableTools: true, RequireToolExplanation: true, DisableStreaming: true, ToolBatchLimit: 2, Workspace: t.TempDir()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if a.ToolBatchLimit() != 2 {
+		t.Fatal("initial policy")
+	}
+	if err = a.SetToolBatchLimit(-1); err == nil || a.ToolBatchLimit() != 2 {
+		t.Fatal("negative budget mutated policy")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Second)
+	defer cancel()
+	done := make(chan error, 1)
+	go func() { _, err := a.Ask(ctx, "first turn"); done <- err }()
+	select {
+	case <-entered:
+	case <-ctx.Done():
+		t.Fatal(ctx.Err())
+	}
+	if err = a.SetToolBatchLimit(18); err != nil {
+		t.Fatal(err)
+	}
+	if a.ToolBatchLimit() != 18 || a.Config().ToolBatchLimit != 2 {
+		t.Fatal("live policy / launch snapshot")
+	}
+	release()
+	if err = <-done; !errors.Is(err, ensemble.ErrToolBatchLimit) {
+		t.Fatalf("active turn budget error=%v", err)
+	}
+	if requests.Load() != 3 {
+		t.Fatalf("active turn requests=%d want3 (two executed batches)", requests.Load())
+	}
+	count := func() int {
+		n := 0
+		for _, e := range a.Log().Events() {
+			if e.Type == "tool_called" {
+				n++
+			}
+		}
+		return n
+	}
+	if n := count(); n != 2 {
+		t.Fatalf("active turn executed %d batches, want2", n)
+	}
+	for _, tc := range []struct{ limit, rounds int }{{18, 18}, {0, 20}, {0, 201}} {
+		if err = a.SetToolBatchLimit(tc.limit); err != nil {
+			t.Fatal(err)
+		}
+		requests.Store(1) // first held-boundary path is only used once
+		wanted.Store(int32(tc.rounds + 1))
+		before := count()
+		_, err = a.Ask(ctx, "next turn")
+		expected := tc.rounds
+		if tc.rounds > ensemble.DefaultToolBatchLimit {
+			expected = ensemble.DefaultToolBatchLimit
+			if !errors.Is(err, ensemble.ErrToolBatchLimit) {
+				t.Fatalf("zero default cap error=%v", err)
+			}
+		} else if err != nil {
+			t.Fatal(err)
+		}
+		if got := count() - before; got != expected {
+			t.Fatalf("policy=%d executed=%d want%d", tc.limit, got, expected)
+		}
+	}
+}
