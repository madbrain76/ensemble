{
  "tools": [
    {
      "name": "read_draft",
      "description": "Read the stored manuscript.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "edit_draft",
      "description": "Replace the stored manuscript.",
      "input_schema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      }
    }
  ],
  "model": "claude-sonnet-4-6",
  "max_tokens": 1024,
  "system": "You are the editor. Read the stored draft with read_draft and improve it with edit_draft. Finish with a short summary. Explain what you will do and why before each tool call.",
  "messages": [
    {
      "role": "user",
      "content": [
        {
          "type": "text",
          "text": "Stored manuscript for editor:\nNew draft after waking the foreground observation."
        }
      ]
    },
    {
      "role": "assistant",
      "content": [
        {
          "type": "text",
          "text": "I will read and edit."
        },
        {
          "type": "tool_use",
          "id": "read",
          "name": "read_draft",
          "input": {}
        },
        {
          "type": "tool_use",
          "id": "edit",
          "name": "edit_draft",
          "input": {
            "text": "Edited wakeup draft with real application-owned handoffs."
          }
        }
      ]
    },
    {
      "role": "user",
      "content": [
        {
          "type": "tool_result",
          "tool_use_id": "read",
          "content": [
            {
              "type": "text",
              "text": "New draft after waking the foreground observation."
            }
          ]
        },
        {
          "type": "tool_result",
          "tool_use_id": "edit",
          "content": [
            {
              "type": "text",
              "text": "stored manuscript"
            }
          ]
        }
      ]
    }
  ]
}
