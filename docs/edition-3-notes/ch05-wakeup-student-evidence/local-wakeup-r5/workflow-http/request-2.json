{
  "tools": [
    {
      "name": "write_draft",
      "description": "Store the first draft text.",
      "input_schema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "word_count",
      "description": "Count whitespace-separated words in the stored draft.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "think",
      "description": "Wait seconds, then return thought.",
      "input_schema": {
        "type": "object",
        "properties": {
          "seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 60
          },
          "thought": {
            "type": "string"
          }
        },
        "required": [
          "seconds",
          "thought"
        ],
        "additionalProperties": false
      }
    }
  ],
  "model": "claude-sonnet-4-6",
  "max_tokens": 1024,
  "system": "You are the author. Write the requested manuscript with write_draft, verify its word_count, and finish with a short summary. Explain what you will do and why before each tool call.",
  "messages": [
    {
      "role": "user",
      "content": [
        {
          "type": "text",
          "text": "write wakeup example"
        }
      ]
    },
    {
      "role": "assistant",
      "content": [
        {
          "type": "text",
          "text": "I will think before drafting."
        },
        {
          "type": "tool_use",
          "id": "limit",
          "name": "tool_limits",
          "input": {
            "ai_callback_delay": 3600
          }
        },
        {
          "type": "tool_use",
          "id": "held",
          "name": "think",
          "input": {
            "seconds": 4,
            "thought": "ACTUAL_ORDINARY_THOUGHT"
          }
        },
        {
          "type": "tool_use",
          "id": "skipped",
          "name": "write_draft",
          "input": {
            "text": "WRONG_UNDISPATCHED_DRAFT"
          }
        }
      ]
    },
    {
      "role": "user",
      "content": [
        {
          "type": "tool_result",
          "tool_use_id": "limit",
          "content": [
            {
              "type": "text",
              "text": "tool_limits set: the next call, whichever tool that is, will report the consumption."
            }
          ]
        },
        {
          "type": "tool_result",
          "tool_use_id": "held",
          "content": [
            {
              "type": "text",
              "text": "[tool_limits consumed by this think call: ai_callback_delay 1h0m0s, ai_callback_pattern none, max_output_bytes 16384]\njob 1 running; 0 bytes; output cr/io/1\n"
            }
          ]
        },
        {
          "type": "tool_result",
          "tool_use_id": "skipped",
          "content": [
            {
              "type": "text",
              "text": "interrupted by incoming message; not executed"
            }
          ],
          "is_error": true
        },
        {
          "type": "text",
          "text": "WORKFLOW_WAKE"
        }
      ]
    }
  ]
}
