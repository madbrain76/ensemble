{
  "tools": [
    {
      "name": "read_file",
      "description": "Read text with one-based inclusive start_line/end_line (omitted or zero: first/EOF) and optional explicit max_bytes. Full uncapped result is retained by the job.",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "start_line": {
            "type": "integer"
          },
          "end_line": {
            "type": "integer"
          },
          "max_bytes": {
            "type": "integer"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "write_file",
      "description": "Create a file and parent directories. Existing files require overwrite:true unless append:true; append preserves existing bytes.",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "overwrite": {
            "type": "boolean"
          },
          "append": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "content"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "edit_file",
      "description": "Replace exactly one literal old_text occurrence with new_text. Empty or ambiguous anchors fail without writing.",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "old_text": {
            "type": "string"
          },
          "new_text": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "old_text",
          "new_text"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list_directory",
      "description": "List immediate entries sorted by name; directories end in /.",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "search_files",
      "description": "Recursively search text with a Go regular expression. context_lines defaults to 0; matching path:line:text and context path-line-text use merged grep-style windows.",
      "input_schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "pattern": {
            "type": "string"
          },
          "context_lines": {
            "type": "integer"
          }
        },
        "required": [
          "path",
          "pattern"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "run_command",
      "description": "Start a fresh /bin/sh in a PTY; merged output and exit_code persist on disk. cwd applies only to this call, relative to Workspace. Delay bounds observation, not execution; a running report is a handle, not cancellation.",
      "input_schema": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string"
          },
          "cwd": {
            "type": "string"
          },
          "ai_callback_delay": {
            "type": "number"
          },
          "ai_callback_pattern": {
            "type": "string"
          },
          "max_output_bytes": {
            "type": "integer"
          }
        },
        "required": [
          "command"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "wait_for_job",
      "description": "Wait for unseen output of a retained job, including a finished job. Never cancels work.",
      "input_schema": {
        "type": "object",
        "properties": {
          "handle": {
            "type": "integer"
          },
          "ai_callback_delay": {
            "type": "number"
          },
          "ai_callback_pattern": {
            "type": "string"
          },
          "max_output_bytes": {
            "type": "integer"
          }
        },
        "required": [
          "handle"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "send_input",
      "description": "Submit a line to an interactive job (adds newline) and wait for unseen output.",
      "input_schema": {
        "type": "object",
        "properties": {
          "handle": {
            "type": "integer"
          },
          "input": {
            "type": "string"
          },
          "ai_callback_delay": {
            "type": "number"
          },
          "ai_callback_pattern": {
            "type": "string"
          },
          "max_output_bytes": {
            "type": "integer"
          }
        },
        "required": [
          "handle",
          "input"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "kill_job",
      "description": "SIGKILL the process group, or mark a Go job killed (Go cannot stop its goroutine).",
      "input_schema": {
        "type": "object",
        "properties": {
          "handle": {
            "type": "integer"
          }
        },
        "required": [
          "handle"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "tool_limits",
      "description": "Set observation limits for the very next call, whichever tool it is; that call reports consumption.",
      "input_schema": {
        "type": "object",
        "properties": {
          "ai_callback_delay": {
            "type": "number"
          },
          "ai_callback_pattern": {
            "type": "string"
          },
          "max_output_bytes": {
            "type": "integer"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    }
  ],
  "model": "claude-sonnet-4-6",
  "max_tokens": 1024,
  "system": "You are a helpful coding assistant. Use the available tools to inspect facts before claiming results. Before each tool batch, write visible text explaining what you will do and why. Tools run in the current working directory, which is not an OS sandbox.",
  "messages": [
    {
      "role": "user",
      "content": [
        {
          "type": "text",
          "text": "start held process"
        }
      ]
    },
    {
      "role": "assistant",
      "content": [
        {
          "type": "text",
          "text": "I will start a held process."
        },
        {
          "type": "tool_use",
          "id": "launch",
          "name": "run_command",
          "input": {
            "command": "printf ready > ready; while [ ! -f release ]; do sleep .02; done; printf 'ACTUAL_PROCESS_FINAL\\n'",
            "ai_callback_delay": 3600,
            "max_output_bytes": 512
          }
        },
        {
          "type": "tool_use",
          "id": "skipped",
          "name": "write_file",
          "input": {
            "path": "must-not-exist",
            "content": "wrong"
          }
        }
      ]
    },
    {
      "role": "user",
      "content": [
        {
          "type": "tool_result",
          "tool_use_id": "launch",
          "content": [
            {
              "type": "text",
              "text": "job 1 running; 0 bytes; output cr/io/1\n"
            }
          ]
        },
        {
          "type": "tool_result",
          "tool_use_id": "skipped",
          "content": [
            {
              "type": "text",
              "text": "interrupted by incoming message; not executed"
            }
          ],
          "is_error": true
        }
      ]
    },
    {
      "role": "assistant",
      "content": [
        {
          "type": "text",
          "text": "I will answer while the process continues."
        },
        {
          "type": "tool_use",
          "id": "answer",
          "name": "write_file",
          "input": {
            "path": "answer.txt",
            "content": "ANSWER_BEFORE_JOB_END"
          }
        }
      ]
    },
    {
      "role": "user",
      "content": [
        {
          "type": "tool_result",
          "tool_use_id": "answer",
          "content": [
            {
              "type": "text",
              "text": "file written"
            }
          ]
        }
      ]
    },
    {
      "role": "assistant",
      "content": [
        {
          "type": "text",
          "text": "I will observe the same job."
        },
        {
          "type": "tool_use",
          "id": "later",
          "name": "wait_for_job",
          "input": {
            "handle": 1,
            "ai_callback_delay": 3600
          }
        }
      ]
    },
    {
      "role": "user",
      "content": [
        {
          "type": "tool_result",
          "tool_use_id": "later",
          "content": [
            {
              "type": "text",
              "text": "job 1 done; 35 bytes; output cr/io/1\nACTUAL_PROCESS_FINAL\n\nexit_code: 0\n"
            }
          ]
        }
      ]
    }
  ]
}
