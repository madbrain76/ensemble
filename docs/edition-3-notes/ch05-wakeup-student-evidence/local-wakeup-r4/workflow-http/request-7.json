{
  "tools": [
    {
      "name": "review",
      "description": "Accept or reject the edited manuscript with notes.",
      "input_schema": {
        "type": "object",
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "accept",
              "reject"
            ]
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "decision",
          "notes"
        ],
        "additionalProperties": false
      }
    }
  ],
  "model": "claude-sonnet-4-6",
  "max_tokens": 1024,
  "system": "You are the reviewer. Read the supplied edited manuscript and call review with decision accept or reject and notes. Finish with a short verdict. Explain what you will do and why before each tool call.",
  "messages": [
    {
      "role": "user",
      "content": [
        {
          "type": "text",
          "text": "Stored manuscript for reviewer:\nEdited wakeup draft with real application-owned handoffs."
        }
      ]
    },
    {
      "role": "assistant",
      "content": [
        {
          "type": "text",
          "text": "I will record acceptance."
        },
        {
          "type": "tool_use",
          "id": "review",
          "name": "review",
          "input": {
            "decision": "accept",
            "notes": "Verified actual revised wakeup draft."
          }
        }
      ]
    },
    {
      "role": "user",
      "content": [
        {
          "type": "tool_result",
          "tool_use_id": "review",
          "content": [
            {
              "type": "text",
              "text": "{\"decision\":\"accept\",\"notes\":\"Verified actual revised wakeup draft.\"}"
            }
          ]
        }
      ]
    }
  ]
}
