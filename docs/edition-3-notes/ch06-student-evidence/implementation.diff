new file mode 100644
index 0000000..85820f0
--- /dev/null
+++ b/cmd/ch01/display.go
@@ -0,0 +1,70 @@
+package main
+
+import (
+	"ensemble"
+	"fmt"
+	"os"
+	"sync"
+)
+
+type displayItem struct {
+	event ensemble.HubEvent
+	err   error
+	write func() error
+}
+
+// The display queue owns slow terminal work. Producers only append copied
+// observations; close happens after root workers and request waiters are joined.
+type displayQueue struct {
+	mu     sync.Mutex
+	cond   *sync.Cond
+	items  []displayItem
+	closed bool
+	err    error
+}
+
+func newDisplayQueue() *displayQueue             { q := &displayQueue{}; q.cond = sync.NewCond(&q.mu); return q }
+func (q *displayQueue) push(e ensemble.HubEvent) { q.add(displayItem{event: e}) }
+func (q *displayQueue) pushError(err error)      { q.add(displayItem{err: err}) }
+func (q *displayQueue) add(v displayItem) {
+	q.mu.Lock()
+	defer q.mu.Unlock()
+	if !q.closed {
+		q.items = append(q.items, v)
+		q.cond.Signal()
+	}
+}
+func (q *displayQueue) close() { q.mu.Lock(); q.closed = true; q.cond.Broadcast(); q.mu.Unlock() }
+func (q *displayQueue) run(show func(ensemble.HubEvent)) {
+	for {
+		q.mu.Lock()
+		for len(q.items) == 0 && !q.closed {
+			q.cond.Wait()
+		}
+		if len(q.items) == 0 && q.closed {
+			q.mu.Unlock()
+			return
+		}
+		batch := q.items
+		q.items = nil
+		q.mu.Unlock()
+		for _, v := range batch {
+			if v.write != nil {
+				q.recordError(v.write())
+			} else if v.err != nil {
+				fmt.Fprintln(os.Stderr, "error:", v.err)
+			} else {
+				show(v.event)
+			}
+		}
+	}
+}
+
+func (q *displayQueue) write(fn func() error) { q.add(displayItem{write: fn}) }
+
+// Called only by the display owner; read only after its done channel closes.
+func (q *displayQueue) recordError(err error) {
+	if q.err == nil {
+		q.err = err
+	}
+}
