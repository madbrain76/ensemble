+func TestLiveProtocolReliableAssistant(t *testing.T) {
+	for _, plain := range []bool{false, true} {
+		t.Run(fmt.Sprint("plain=", plain), func(t *testing.T) {
+			path := cliSettings(t)
+			if plain {
+				t.Setenv("EN_DISABLE_STREAMING", "1")
+			} else {
+				t.Setenv("EN_DISABLE_STREAMING", "")
+			}
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if plain {
+					fmt.Fprint(w, `{"model":"claude-sonnet-4-6","content":[{"type":"text","text":"reliable live answer"}],"usage":{"input_tokens":0,"output_tokens":0}}`)
+					return
+				}
+				w.Header().Set("Content-Type", "text/event-stream")
+				for _, frame := range []string{
+					`{"type":"message_start","message":{"model":"claude-sonnet-4-6","usage":{"input_tokens":0,"output_tokens":0}}}`,
+					`{"type":"content_block_start","index":0,"content_block":{"type":"text","text":"reliable "}}`,
+					`{"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"live answer"}}`,
+					`{"type":"content_block_stop","index":0}`, `{"type":"message_stop"}`,
+				} {
+					fmt.Fprintf(w, "data: %s\n\n", frame)
+					w.(http.Flusher).Flush()
+				}
+			}))
+			defer server.Close()
+			t.Setenv("LLM_MODEL", "claude-sonnet-4-6")
+			t.Setenv("LLM_API_KEY", "fixture-key")
+			t.Setenv("LLM_BASE_URL", server.URL)
+			var stdout bytes.Buffer
+			if err := execute(t, nil, strings.NewReader("{\"kind\":\"prompt\",\"text\":\"inspect config\"}\n"), &stdout); err != nil {
+				t.Fatal(err)
+			}
+			decoder := json.NewDecoder(bytes.NewReader(stdout.Bytes()))
+			answers, deltas, finals := 0, 0, 0
+			for decoder.More() {
+				var record map[string]any
+				if err := decoder.Decode(&record); err != nil {
+					t.Fatal(err)
+				}
+				if text, ok := record["assistant"]; ok {
+					answers++
+					if text != "reliable live answer" {
+						t.Fatalf("answer=%v", text)
+					}
+				}
+				switch record["observation"] {
+				case "part_delta":
+					deltas++
+				case "part_final":
+					finals++
+				}
+			}
+			if answers != 1 || deltas < 1 || finals != 1 {
+				t.Fatalf("reliable completion absent: answers=%d deltas=%d finals=%d stdout=%s", answers, deltas, finals, stdout.String())
+			}
+			saved, err := os.ReadFile(path)
+			if err != nil || !bytes.Contains(saved, []byte("reliable live answer")) {
+				t.Fatalf("save-before-return err=%v history=%s", err, saved)
+			}
+		})
+	}
+}
