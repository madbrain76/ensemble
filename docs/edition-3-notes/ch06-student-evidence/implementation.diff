+package ensemble_test
+
+import (
+	"bytes"
+	"ensemble"
+	"io"
+	"log"
+	"net/http"
+	"testing"
+)
+
+// The old tests deliberately render/parse foreign surfaces. Configuration now
+// belongs to the Engine's parent, so those cases construct a matching owner.
+func targetAgent(t *testing.T, a ensemble.Agent, to ensemble.Provenance) ensemble.Agent {
+	t.Helper()
+	if a.Engine().Target() == to {
+		return a
+	}
+	root := ensemble.New(log.New(io.Discard, "", 0))
+	t.Cleanup(func() { _ = root.Shutdown() })
+	cfg := a.Config()
+	cfg.Vendor = to.Vendor
+	cfg.Model = to.Model
+	cfg.ResolvedModel = to.Model
+	cfg.HistoryPath = ""
+	b, err := root.NewAgent(cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return b
+}
+func renderAt(t *testing.T, a ensemble.Agent, c ensemble.Context, to ensemble.Provenance) ([]byte, error) {
+	return targetAgent(t, a, to).Engine().Render(&c)
+}
+func parseAt(t *testing.T, a ensemble.Agent, b []byte, from ensemble.Provenance) (ensemble.ResponseEvent, error) {
+	var out ensemble.ResponseEvent
+	resp := &http.Response{StatusCode: 200, Header: http.Header{"Content-Type": []string{"application/json"}}, Body: io.NopCloser(bytes.NewReader(b))}
+	err := targetAgent(t, a, from).Engine().Parse(resp, ensemble.StreamCallbacks{OnEvent: func(e ensemble.Event) {
+		if e.Response != nil {
+			out = *e.Response
+		}
+	}})
+	return out, err
+}
