@@ -0,0 +1,71 @@
+package common
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+)
+
+// Parser translates either a plain response or a live SSE response.
+// Callbacks are synchronous; consumers must queue slow work.
+type Parser interface {
+	Parse(*http.Response, StreamCallbacks) error
+}
+
+// StreamCallbacks are request-scoped response notifications, never services.
+type StreamCallbacks struct {
+	OnDelta     func(partID uint64, kind DeltaKind, chunk string)
+	OnEvent     func(Event)
+	OnPartFinal func(partID uint64, part Part)
+	OnFrame     func(eventType string, data []byte)
+}
+
+// DeltaKind is display taxonomy, not the durable Part union.
+type DeltaKind uint8
+
+const (
+	DeltaThinking DeltaKind = iota + 1
+	DeltaText
+	DeltaToolCall
+)
+
+func (k DeltaKind) String() string {
+	switch k {
+	case DeltaThinking:
+		return "thinking"
+	case DeltaText:
+		return "text"
+	case DeltaToolCall:
+		return "tool_call"
+	}
+	return "invalid"
+}
+func (k DeltaKind) MarshalJSON() ([]byte, error) {
+	if k < DeltaThinking || k > DeltaToolCall {
+		return nil, fmt.Errorf("invalid delta kind")
+	}
+	return json.Marshal(k.String())
+}
+func (k *DeltaKind) UnmarshalJSON(b []byte) error {
+	var s string
+	if err := json.Unmarshal(b, &s); err != nil {
+		return err
+	}
+	for _, v := range []DeltaKind{DeltaThinking, DeltaText, DeltaToolCall} {
+		if v.String() == s {
+			*k = v
+			return nil
+		}
+	}
+	return fmt.Errorf("invalid delta kind")
+}
+
+// Stream is a model's independently supported incremental output classes.
+type Stream uint8
+
+const (
+	StreamText Stream = 1 << iota
+	StreamThinking
+	StreamToolArgs
+	StreamAll = StreamText | StreamThinking | StreamToolArgs
+)
