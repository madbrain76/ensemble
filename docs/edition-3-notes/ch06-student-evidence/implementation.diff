diff --git a/evidence/ch06/controls/run.py b/evidence/ch06/controls/run.py
new file mode 100644
index 0000000..0586f39
--- /dev/null
+++ b/evidence/ch06/controls/run.py
@@ -0,0 +1,29 @@
+#!/usr/bin/env python3
+"""Local compile-success controls. Only the three exact source anchors below change."""
+import difflib,hashlib,json,pathlib,subprocess
+root=pathlib.Path(__file__).resolve().parents[3]
+controls=[
+ ('no-live-deltas','internal/engine/stream.go','a := newAccumulator(from, cb)','mutantCB := cb; mutantCB.OnDelta=nil; a := newAccumulator(from, mutantCB)','TestChapter6DelayedPublicProgressAndReset'),
+ ('drop-zero','internal/engine/stream.go','if cb.OnPartFinal != nil {','if cb.OnPartFinal != nil && ids[i] != 0 {','TestChapter6PlainStreamParity'),
+ ('final-order-only','internal/agent/actor.go','explained := m.explained','explained := true','TestChapter6ArrivalAuthorizesTools'),
+]
+receipts=[]
+for name,file,old,new,test in controls:
+ p=root/file;before=p.read_bytes();text=before.decode();assert text.count(old)==1
+ changed=text.replace(old,new).encode();out=pathlib.Path(__file__).parent/name;out.mkdir(exist_ok=True)
+ (out/'mutation.diff').write_text(''.join(difflib.unified_diff(text.splitlines(True),changed.decode().splitlines(True),fromfile=file,tofile=file)))
+ def run(label,args):
+  result=subprocess.run(args,cwd=root,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,timeout=60)
+  (out/(label+'.txt')).write_bytes(result.stdout)
+  return {'argv':args,'exit':result.returncode}
+ receipt={'name':name,'file':file,'original_sha256':hashlib.sha256(before).hexdigest(),'mutated_sha256':hashlib.sha256(changed).hexdigest()}
+ try:
+  p.write_bytes(changed)
+  receipt['compile']=run('compile',['go','test','.','-run','^$','-timeout','30s','-count=1'])
+  receipt['behavior']=run('behavior',['go','test','.','-run','^'+test+'$','-timeout','20s','-count=1','-v'])
+ finally:p.write_bytes(before)
+ receipt['restored_sha256']=hashlib.sha256(p.read_bytes()).hexdigest()
+ receipt['restored']=run('restored',['go','test','.','-run','^'+test+'$','-timeout','20s','-count=1','-v'])
+ receipts.append(receipt);(pathlib.Path(__file__).parent/'receipts.json').write_text(json.dumps(receipts,indent=2)+'\n')
+ print(name,receipt,flush=True)
+ assert receipt['compile']['exit']==0 and receipt['behavior']['exit']!=0 and receipt['restored']['exit']==0
