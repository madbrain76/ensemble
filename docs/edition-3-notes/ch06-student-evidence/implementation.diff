+// ch07 measures stream shape using only the public library.
+package main
+
+import (
+	"bufio"
+	"context"
+	"encoding/json"
+	"ensemble"
+	"fmt"
+	"log"
+	"os"
+	"strconv"
+	"sync"
+	"time"
+)
+
+func main() {
+	if err := run(); err != nil {
+		fmt.Fprintln(os.Stderr, err)
+		os.Exit(1)
+	}
+}
+func env(k, d string) string {
+	if v := os.Getenv(k); v != "" {
+		return v
+	}
+	return d
+}
+func run() error {
+	v := ensemble.Anthropic
+	switch os.Getenv("LLM_VENDOR") {
+	case "openai":
+		v = ensemble.OpenAI
+	case "gemini":
+		v = ensemble.Gemini
+	case "", "anthropic":
+	default:
+		return fmt.Errorf("unsupported vendor")
+	}
+	defaults := map[ensemble.Vendor]string{ensemble.Anthropic: "claude-sonnet-4-6", ensemble.OpenAI: "gpt-4.1-2025-04-14", ensemble.Gemini: "gemini-3.8-flash"}
+	origins := map[ensemble.Vendor]string{ensemble.Anthropic: "https://api.anthropic.com", ensemble.OpenAI: "https://api.openai.com", ensemble.Gemini: "https://generativelanguage.googleapis.com"}
+	limit, _ := strconv.Atoi(env("LLM_MAX_TOKENS", "1024"))
+	batches, _ := strconv.Atoi(env("LLM_TOOL_BATCH_LIMIT", "200"))
+	cfg := ensemble.Config{Vendor: v, Model: env("LLM_MODEL", defaults[v]), BaseURL: env("LLM_BASE_URL", origins[v]), APIKey: os.Getenv("LLM_API_KEY"), System: "You are a concise coding assistant. Explain briefly before tools.", MaxTokens: limit, EnableTools: true, RequireToolExplanation: true, ToolBatchLimit: batches, DisableStreaming: os.Getenv("CH07_NO_STREAM") == "1", HistoryPath: env("CH07_AGENT_LOG", "ch07-agent.jsonl")}
+	root := ensemble.New(log.New(os.Stderr, "", 0))
+	defer root.Shutdown()
+	trace, err := os.OpenFile("api.log", os.O_CREATE|os.O_APPEND|os.O_WRONLY, 0600)
+	if err != nil {
+		return err
+	}
+	defer trace.Close()
+	root.SetAPITrace(trace)
+	a, err := root.NewAgent(cfg)
+	if err != nil {
+		return err
+	}
+	prompt := "what does the configuration say?"
+	scan := bufio.NewScanner(os.Stdin)
+	if scan.Scan() {
+		var input struct {
+			Text string `json:"text"`
+		}
+		if json.Unmarshal(scan.Bytes(), &input) == nil && input.Text != "" {
+			prompt = input.Text
+		} else {
+			prompt = scan.Text()
+		}
+	}
+	if err := scan.Err(); err != nil {
+		return err
+	}
+	var mu sync.Mutex
+	counts := map[string]int{"text": 0, "thinking": 0, "tool_call": 0}
+	parts := 0
+	first := -1.0
+	start := time.Now()
+	a.Observe(func(e ensemble.HubEvent) {
+		mu.Lock()
+		defer mu.Unlock()
+		switch x := e.(type) {
+		case ensemble.PartDelta:
+			if x.Origin == "provider" {
+				if first < 0 {
+					first = float64(time.Since(start).Microseconds()) / 1000
+				}
+				counts[x.Kind.String()]++
+			}
+		case ensemble.PartFinal:
+			if x.Response != 0 {
+				parts++
+			}
+		}
+	})
+	answer, err := a.Ask(context.Background(), prompt)
+	if err != nil {
+		return err
+	}
+	if err = root.Shutdown(); err != nil {
+		return err
+	}
+	mu.Lock()
+	defer mu.Unlock()
+	return json.NewEncoder(os.Stdout).Encode(map[string]any{"observation": "stream_stats", "deltas": counts, "parts": parts, "first_delta_ms": first, "elapsed_ms": float64(time.Since(start).Microseconds()) / 1000, "streaming": ensemble.StreamingFor(cfg) != 0, "usage": a.Engine().Usage(), "assistant": answer})
+}
