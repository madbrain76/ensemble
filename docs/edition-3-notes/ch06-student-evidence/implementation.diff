index 0000000..34566d1
--- /dev/null
+++ b/internal/engine/sse.go
@@ -0,0 +1,61 @@
+package engine
+
+import (
+	"bufio"
+	"fmt"
+	"io"
+	"strings"
+)
+
+// readSSE owns framing only. Returning false stops immediately (e.g. [DONE]).
+// EOF dispatches a pending final event, including an empty data field.
+func readSSE(r io.Reader, frame func(string, []byte) (bool, error)) error {
+	reader := bufio.NewReader(r)
+	var event string
+	var data []string
+	dispatch := func() (bool, error) {
+		if data == nil {
+			event = ""
+			return true, nil
+		}
+		payload := []byte(strings.Join(data, "\n"))
+		kind := event
+		event = ""
+		data = nil
+		return frame(kind, payload)
+	}
+	for {
+		line, err := reader.ReadString('\n')
+		if len(line) > 16<<20 {
+			return fmt.Errorf("SSE line too large")
+		}
+		if len(line) > 0 {
+			line = strings.TrimSuffix(strings.TrimSuffix(line, "\n"), "\r")
+			if line == "" {
+				more, e := dispatch()
+				if e != nil {
+					return e
+				}
+				if !more {
+					return nil
+				}
+			} else if !strings.HasPrefix(line, ":") {
+				field, value, _ := strings.Cut(line, ":")
+				value = strings.TrimPrefix(value, " ")
+				switch field {
+				case "event":
+					event = value
+				case "data":
+					data = append(data, value)
+				}
+			}
+		}
+		if err != nil {
+			if err != io.EOF {
+				return fmt.Errorf("read SSE body")
+			}
+			_, e := dispatch()
+			return e
+		}
+	}
+}
diff --git a/internal/engine/stream.go b/internal/engine/stream.go
new file mode 100644
index 0000000..28fd47b
--- /dev/null
+++ b/internal/engine/stream.go
@@ -0,0 +1,523 @@
+package engine
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"mime"
+	"net/http"
+	"sort"
+	"strings"
+
+	"ensemble/internal/common"
+)
+
+// Parse is the only provider parsing seam. The caller owns body closure.
+func (e *Engine) Parse(resp *http.Response, cb common.StreamCallbacks) error {
+	if resp == nil || resp.Body == nil {
+		return fmt.Errorf("missing provider response")
+	}
+	if resp.StatusCode < 200 || resp.StatusCode >= 300 {
+		return fmt.Errorf("%s HTTP %d", e.Target().Vendor, resp.StatusCode)
+	}
+	from := e.Target()
+	if model := e.parent.Config().ResolvedModel; model != "" {
+		from.Model = model
+	}
+	typ, _, _ := mime.ParseMediaType(resp.Header.Get("Content-Type"))
+	var data []byte
+	var ids []uint64
+	var err error
+	streamed := typ == "text/event-stream"
+	if streamed {
+		a := newAccumulator(from, cb)
+		err = readSSE(resp.Body, func(kind string, b []byte) (bool, error) {
+			if cb.OnFrame != nil {
+				cb.OnFrame(kind, e.frameData(b))
+			}
+			if string(b) == "[DONE]" {
+				if from.Vendor != common.OpenAI {
+					return false, fmt.Errorf("unexpected stream sentinel")
+				}
+				a.done = true
+				return false, nil
+			}
+			if err := a.frame(kind, b); err != nil {
+				return false, err
+			}
+			return !(from.Vendor == common.Anthropic && a.done), nil
+		})
+		if err == nil {
+			data, ids, err = a.finish()
+		}
+	} else {
+		data, err = io.ReadAll(resp.Body)
+		if err != nil {
+			return fmt.Errorf("read %s response body", from.Vendor)
+		}
+		if cb.OnFrame != nil {
+			cb.OnFrame("response", e.frameData(data))
+		}
+	}
+	if err != nil {
+		return err
+	}
+	result, err := decodeResponse(data, from)
+	// Measured usage survives an otherwise unusable response, as before streaming.
+	if cb.OnEvent != nil && result.From != (common.Provenance{}) {
+		var notify common.ResponseEvent
+		b, _ := json.Marshal(result)
+		_ = json.Unmarshal(b, &notify)
+		cb.OnEvent(common.Event{Type: "response_ended", Response: &notify})
+	}
+	if err != nil {
+		return err
+	}
+	if !streamed {
+		ids = make([]uint64, len(result.Parts))
+		for i, p := range result.Parts {
+			ids[i] = uint64(i)
+			emitPartDelta(cb, ids[i], p)
+		}
+	}
+	if len(ids) != len(result.Parts) {
+		return fmt.Errorf("provider part identity mismatch")
+	}
+	for i, p := range result.Parts {
+		if cb.OnPartFinal != nil {
+			var notify common.Part
+			b, _ := json.Marshal(p)
+			_ = json.Unmarshal(b, &notify)
+			cb.OnPartFinal(ids[i], notify)
+		}
+	}
+	return nil
+}
+
+func emitPartDelta(cb common.StreamCallbacks, id uint64, p common.Part) {
+	if cb.OnDelta == nil {
+		return
+	}
+	switch p.Type {
+	case "text":
+		if p.Text != "" {
+			cb.OnDelta(id, common.DeltaText, p.Text)
+		}
+	case "thinking":
+		if p.Text != "" {
+			cb.OnDelta(id, common.DeltaThinking, p.Text)
+		}
+	case "opaque":
+		var v map[string]any
+		_ = json.Unmarshal(p.Data, &v)
+		thought := str(v, "thinking")
+		if str(v, "reasoning_content") != "" {
+			thought = str(v, "reasoning_content")
+		}
+		if b, _ := v["thought"].(bool); b {
+			thought = str(v, "text")
+		}
+		if thought != "" {
+			cb.OnDelta(id, common.DeltaThinking, thought)
+		}
+	case "tool_call":
+		cb.OnDelta(id, common.DeltaToolCall, p.Name+string(p.Args))
+	}
+}
+
+// A block retains the provider's final wire representation and its response ID.
+type streamBlock struct {
+	id      uint64
+	kind    string
+	wire    map[string]any
+	args    string
+	stopped bool
+}
+type accumulator struct {
+	from          common.Provenance
+	cb            common.StreamCallbacks
+	blocks        map[int]*streamBlock
+	order         []*streamBlock
+	next          uint64
+	model         string
+	usage         map[string]any
+	done          bool
+	text, thought *streamBlock
+	tools         map[int]*streamBlock
+	last          *streamBlock
+}
+
+func newAccumulator(from common.Provenance, cb common.StreamCallbacks) *accumulator {
+	return &accumulator{from: from, cb: cb, blocks: map[int]*streamBlock{}, tools: map[int]*streamBlock{}, model: from.Model}
+}
+func (a *accumulator) block(kind string, wire map[string]any) *streamBlock {
+	b := &streamBlock{id: a.next, kind: kind, wire: wire}
+	a.next++
+	a.order = append(a.order, b)
+	return b
+}
+func (a *accumulator) delta(b *streamBlock, kind common.DeltaKind, s string) {
+	if s != "" && a.cb.OnDelta != nil {
+		a.cb.OnDelta(b.id, kind, s)
+	}
+}
+func object(v any) map[string]any           { m, _ := v.(map[string]any); return m }
+func str(m map[string]any, k string) string { s, _ := m[k].(string); return s }
+func index(m map[string]any) (int, error) {
+	n, ok := m["index"].(float64)
+	if !ok || n < 0 || n != float64(int(n)) {
+		return 0, fmt.Errorf("invalid stream block index")
+	}
+	return int(n), nil
+}
+func (a *accumulator) frame(kind string, data []byte) error {
+	var v map[string]any
+	if json.Unmarshal(data, &v) != nil || v == nil {
+		return fmt.Errorf("invalid %s stream frame", a.from.Vendor)
+	}
+	if v["error"] != nil || kind == "error" || str(v, "type") == "error" {
+		return fmt.Errorf("%s stream error", a.from.Vendor)
+	}
+	switch a.from.Vendor {
+	case common.Anthropic:
+		return a.anthropic(v)
+	case common.OpenAI:
+		return a.openai(v)
+	case common.Gemini:
+		return a.gemini(v)
+	}
+	return fmt.Errorf("unsupported streaming provider")
+}
+func (a *accumulator) anthropic(v map[string]any) error {
+	switch str(v, "type") {
+	case "ping":
+		return nil
+	case "message_start":
+		msg := object(v["message"])
+		if model := str(msg, "model"); model != "" {
+			a.model = model
+		}
+		a.usage = object(msg["usage"])
+	case "content_block_start":
+		i, err := index(v)
+		if err != nil {
+			return err
+		}
+		if a.blocks[i] != nil {
+			return fmt.Errorf("duplicate stream block")
+		}
+		wire := object(v["content_block"])
+		kind := str(wire, "type")
+		if wire == nil {
+			return fmt.Errorf("missing stream block")
+		}
+		b := a.block(kind, wire)
+		b.id = uint64(i)
+		a.blocks[i] = b
+		switch kind {
+		case "text":
+			a.delta(b, common.DeltaText, str(wire, "text"))
+		case "thinking":
+			a.delta(b, common.DeltaThinking, str(wire, "thinking"))
+		case "tool_use":
+			a.delta(b, common.DeltaToolCall, str(wire, "name"))
+		case "redacted_thinking":
+		default:
+			return fmt.Errorf("unsupported stream block")
+		}
+	case "content_block_delta":
+		i, err := index(v)
+		if err != nil {
+			return err
+		}
+		b := a.blocks[i]
+		if b == nil || b.stopped {
+			return fmt.Errorf("delta outside stream block")
+		}
+		d := object(v["delta"])
+		switch str(d, "type") {
+		case "text_delta":
+			if b.kind != "text" {
+				return fmt.Errorf("stream kind changed")
+			}
+			s := str(d, "text")
+			b.wire["text"] = str(b.wire, "text") + s
+			a.delta(b, common.DeltaText, s)
+		case "thinking_delta":
+			if b.kind != "thinking" {
+				return fmt.Errorf("stream kind changed")
+			}
+			s := str(d, "thinking")
+			b.wire["thinking"] = str(b.wire, "thinking") + s
+			a.delta(b, common.DeltaThinking, s)
+		case "signature_delta":
+			if b.kind != "thinking" {
+				return fmt.Errorf("signature outside thinking")
+			}
+			b.wire["signature"] = str(b.wire, "signature") + str(d, "signature")
+		case "input_json_delta":
+			if b.kind != "tool_use" {
+				return fmt.Errorf("arguments outside tool")
+			}
+			s := str(d, "partial_json")
+			b.args += s
+			a.delta(b, common.DeltaToolCall, s)
+		default:
+			return fmt.Errorf("unsupported stream delta")
+		}
+	case "content_block_stop":
+		i, err := index(v)
+		if err != nil {
+			return err
+		}
+		b := a.blocks[i]
+		if b == nil || b.stopped {
+			return fmt.Errorf("invalid stream block stop")
+		}
+		b.stopped = true
+		if b.kind == "tool_use" && b.args != "" {
+			var args any
+			if json.Unmarshal([]byte(b.args), &args) != nil {
+				return fmt.Errorf("invalid streamed tool arguments")
+			}
+			b.wire["input"] = args
+		}
+	case "message_delta":
+		if u := object(v["usage"]); u != nil {
+			if a.usage == nil {
+				a.usage = map[string]any{}
+			}
+			for k, n := range u {
+				a.usage[k] = n
+			}
+		}
+	case "message_stop":
+		a.done = true
+	default:
+		return fmt.Errorf("unsupported Anthropic stream event")
+	}
+	return nil
+}
+func (a *accumulator) openai(v map[string]any) error {
+	if m := str(v, "model"); m != "" {
+		a.model = m
+	}
+	if u := object(v["usage"]); u != nil {
+		a.usage = u
+	}
+	choices, _ := v["choices"].([]any)
+	for _, choice := range choices {
+		c := object(choice)
+		if n, ok := c["index"].(float64); ok && n != 0 {
+			return fmt.Errorf("multiple streamed choices unsupported")
+		}
+		d := object(c["delta"])
+		if s := str(d, "reasoning_content"); s != "" {
+			if a.thought == nil {
+				a.thought = a.block("thinking", map[string]any{})
+			}
+			a.thought.wire["text"] = str(a.thought.wire, "text") + s
+			a.delta(a.thought, common.DeltaThinking, s)
+		}
+		if s := str(d, "content"); s != "" {
+			if a.text == nil {
+				a.text = a.block("text", map[string]any{})
+			}
+			a.text.wire["text"] = str(a.text.wire, "text") + s
+			a.delta(a.text, common.DeltaText, s)
+		}
+		tools, _ := d["tool_calls"].([]any)
+		for _, tool := range tools {
+			t := object(tool)
+			i, err := index(t)
+			if err != nil {
+				return err
+			}
+			b := a.tools[i]
+			if b == nil {
+				b = a.block("tool_call", map[string]any{"type": "function", "function": map[string]any{}})
+				a.tools[i] = b
+			}
+			if id := str(t, "id"); id != "" {
+				b.wire["id"] = str(b.wire, "id") + id
+			}
+			f := object(t["function"])
+			out := object(b.wire["function"])
+			if s := str(f, "name"); s != "" {
+				out["name"] = str(out, "name") + s
+				a.delta(b, common.DeltaToolCall, s)
+			}
+			if s := str(f, "arguments"); s != "" {
+				b.args += s
+				a.delta(b, common.DeltaToolCall, s)
+			}
+		}
+
+	}
+	return nil
+}
+func (a *accumulator) gemini(v map[string]any) error {
+	if m := str(v, "modelVersion"); m != "" {
+		a.model = m
+	}
+	if u := object(v["usageMetadata"]); u != nil {
+		a.usage = u
+	}
+	candidates, _ := v["candidates"].([]any)
+	if len(candidates) > 1 {
+		return fmt.Errorf("multiple streamed candidates unsupported")
+	}
+	for _, candidate := range candidates {
+		c := object(candidate)
+		content := object(c["content"])
+		parts, _ := content["parts"].([]any)
+		for _, raw := range parts {
+			p := object(raw)
+			kind := ""
+			if _, ok := p["text"]; ok {
+				kind = "text"
+				if thought, _ := p["thought"].(bool); thought {
+					kind = "thinking"
+				}
+			} else if p["functionCall"] != nil {
+				kind = "tool_call"
+			}
+			if kind == "" {
+				if sig, ok := p["thoughtSignature"]; ok && a.last != nil {
+					a.last.wire["thoughtSignature"] = sig
+					continue
+				}
+				return fmt.Errorf("unsupported Gemini stream part")
+			}
+			b := a.last
+			// Gemini has no indices. Only adjacent same-kind text can continue.
+			if b == nil || b.kind != kind || kind == "tool_call" {
+				b = a.block(kind, p)
+				a.last = b
+			} else {
+				b.wire["text"] = str(b.wire, "text") + str(p, "text")
+				if sig, ok := p["thoughtSignature"]; ok {
+					b.wire["thoughtSignature"] = sig
+				}
+			}
+			switch kind {
+			case "text":
+				a.delta(b, common.DeltaText, str(p, "text"))
+			case "thinking":
+				a.delta(b, common.DeltaThinking, str(p, "text"))
+			case "tool_call":
+				f := object(p["functionCall"])
+				args, _ := json.Marshal(f["args"])
+				a.delta(b, common.DeltaToolCall, str(f, "name")+string(args))
+			}
+		}
+		if str(c, "finishReason") != "" {
+			a.done = true
+		}
+	}
+	return nil
+}
+func (a *accumulator) finish() ([]byte, []uint64, error) {
+	if !a.done {
+		return nil, nil, fmt.Errorf("incomplete %s stream", a.from.Vendor)
+	}
+	ids := []uint64{}
+	var wire any
+	switch a.from.Vendor {
+	case common.Anthropic:
+		indices := []int{}
+		for i := range a.blocks {
+			indices = append(indices, i)
+		}
+		sort.Ints(indices)
+		content := []any{}
+		for _, i := range indices {
+			b := a.blocks[i]
+			if !b.stopped {
+				return nil, nil, fmt.Errorf("incomplete stream block")
+			}
+			content = append(content, b.wire)
+			ids = append(ids, b.id)
+		}
+		wire = map[string]any{"model": a.model, "content": content, "usage": a.usage}
+	case common.OpenAI:
+		msg := map[string]any{}
+		if a.thought != nil {
+			msg["reasoning_content"] = str(a.thought.wire, "text")
+
+		}
+		if a.text != nil {
+			msg["content"] = str(a.text.wire, "text")
+			ids = append(ids, a.text.id)
+		}
+		indices := []int{}
+		for i := range a.tools {
+			indices = append(indices, i)
+		}
+		sort.Ints(indices)
+		tools := []any{}
+		for _, i := range indices {
+			b := a.tools[i]
+			object(b.wire["function"])["arguments"] = b.args
+			tools = append(tools, b.wire)
+			ids = append(ids, b.id)
+		}
+		msg["tool_calls"] = tools
+		if a.thought != nil {
+			ids = append(ids, a.thought.id)
+		}
+		wire = map[string]any{"model": a.model, "choices": []any{map[string]any{"message": msg}}, "usage": a.usage}
+	case common.Gemini:
+		parts := []any{}
+		for _, b := range a.order {
+			parts = append(parts, b.wire)
+			ids = append(ids, b.id)
+		}
+		wire = map[string]any{"modelVersion": a.model, "candidates": []any{map[string]any{"content": map[string]any{"parts": parts}}}, "usageMetadata": a.usage}
+	}
+	data, err := json.Marshal(wire)
+	return data, ids, err
+}
+
+// Trace payloads omit replay-only private bytes and authentication-shaped fields.
+func sanitizeFrame(data []byte, key string) []byte {
+	var v any
+	if json.Unmarshal(data, &v) != nil {
+		return []byte(`"[non-JSON frame]"`)
+	}
+	var scrub func(any)
+	scrub = func(x any) {
+		switch n := x.(type) {
+		case map[string]any:
+			for k, val := range n {
+				lower := strings.ToLower(k)
+				if strings.Contains(lower, "signature") || strings.Contains(lower, "thinking") || strings.Contains(lower, "reasoning") || strings.Contains(lower, "key") || strings.Contains(lower, "authorization") || lower == "headers" || lower == "data" {
+					n[k] = "[redacted]"
+				} else {
+					scrub(val)
+				}
+			}
+		case []any:
+			for _, val := range n {
+				scrub(val)
+			}
+		}
+	}
+	scrub(v)
+	b, _ := json.Marshal(v)
+	if key != "" {
+		b = []byte(strings.ReplaceAll(string(b), key, "[redacted]"))
+	}
+	return b
+}
+
+// Frame observers receive owned bytes with this Agent's configured credential removed.
+// Replay-only provider fields remain available to private diagnostic consumers.
+func (e *Engine) frameData(data []byte) []byte {
+	key := e.parent.Config().APIKey
+	s := string(data)
+	if key != "" {
+		s = strings.ReplaceAll(s, key, "[redacted]")
+	}
+	return []byte(s)
+}
