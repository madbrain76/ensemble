+func TestDisplayQueueSlowConsumerDrain(t *testing.T) {
+	q := newDisplayQueue()
+	entered, release, done := make(chan struct{}), make(chan struct{}), make(chan struct{})
+	seen := []uint64{}
+	go func() {
+		defer close(done)
+		q.run(func(o ensemble.HubEvent) {
+			d := o.(ensemble.PartDelta)
+			if d.PartID == 0 {
+				close(entered)
+				<-release
+			}
+			seen = append(seen, d.PartID)
+		})
+	}()
+	q.push(ensemble.PartDelta{PartID: 0})
+	<-entered
+	admitted := make(chan struct{})
+	go func() {
+		for i := 1; i <= 1000; i++ {
+			q.push(ensemble.PartDelta{PartID: uint64(i)})
+		}
+		q.close()
+		close(admitted)
+	}()
+	select {
+	case <-admitted:
+	case <-time.After(time.Second):
+		close(release)
+		t.Fatal("slow display blocked admission")
+	}
+	close(release)
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("drain hung")
+	}
+	if len(seen) != 1001 || seen[0] != 0 || seen[1000] != 1000 {
+		t.Fatal("ordered drain lost entries")
+	}
+}
