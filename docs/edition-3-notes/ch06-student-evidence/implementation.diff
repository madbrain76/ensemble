@@ -0,0 +1,473 @@
+package ensemble_test
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"ensemble"
+	"fmt"
+	"io"
+	"log"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+)
+
+type streamFixture struct {
+	vendor        ensemble.Vendor
+	plain, stream string
+}
+
+func frame(s string) string { return "data: " + s + "\n\n" }
+func anthStart() string {
+	return frame(`{"type":"message_start","message":{"model":"resolved","usage":{"input_tokens":0,"output_tokens":0,"cache_creation_input_tokens":2,"cache_read_input_tokens":3}}}`)
+}
+func anthBlock(i int, kind, value string) string {
+	return frame(fmt.Sprintf(`{"type":"content_block_start","index":%d,"content_block":{"type":%q,%q:%q}}`, i, kind, map[string]string{"text": "text", "thinking": "thinking"}[kind], value))
+}
+func anthStop(i int) string { return frame(fmt.Sprintf(`{"type":"content_block_stop","index":%d}`, i)) }
+func anthEnd() string {
+	return frame(`{"type":"message_delta","delta":{"stop_reason":"end_turn"},"usage":{"output_tokens":0}}`) + frame(`{"type":"message_stop"}`)
+}
+func fixtures6() []streamFixture {
+	return []streamFixture{
+		{ensemble.Anthropic, `{"model":"resolved","content":[{"type":"text","text":"hello"},{"type":"thinking","thinking":"plan","signature":"private-signature"},{"type":"tool_use","id":"c","name":"lookup","input":{"q":"x"}}],"usage":{"input_tokens":0,"output_tokens":0,"cache_creation_input_tokens":2,"cache_read_input_tokens":3}}`, anthStart() + anthBlock(0, "text", "he") + frame(`{"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"llo"}}`) + anthStop(0) + anthBlock(1, "thinking", "plan") + frame(`{"type":"content_block_delta","index":1,"delta":{"type":"signature_delta","signature":"private-signature"}}`) + anthStop(1) + frame(`{"type":"content_block_start","index":2,"content_block":{"type":"tool_use","id":"c","name":"lookup","input":{}}}`) + frame(`{"type":"content_block_delta","index":2,"delta":{"type":"input_json_delta","partial_json":"{\"q\":"}}`) + frame(`{"type":"content_block_delta","index":2,"delta":{"type":"input_json_delta","partial_json":"\"x\"}"}}`) + anthStop(2) + anthEnd()},
+		{ensemble.OpenAI, `{"model":"resolved","choices":[{"message":{"content":"hello","reasoning_content":"plan","tool_calls":[{"id":"c","type":"function","function":{"name":"lookup","arguments":"{\"q\":\"x\"}"}}]}}],"usage":{"prompt_tokens":5,"completion_tokens":0,"prompt_tokens_details":{"cached_tokens":3,"cache_write_tokens":2}}}`, frame(`{"model":"resolved","choices":[{"index":0,"delta":{"reasoning_content":"plan"}}]}`) + frame(`{"choices":[{"index":0,"delta":{"content":"he"}}]}`) + frame(`{"choices":[{"index":0,"delta":{"content":"llo","tool_calls":[{"index":2,"id":"c","type":"function","function":{"name":"lookup","arguments":"{\"q\":"}}]}}]}`) + frame(`{"choices":[{"index":0,"delta":{"tool_calls":[{"index":2,"function":{"arguments":"\"x\"}"}}]},"finish_reason":"tool_calls"}]}`) + frame(`{"choices":[],"usage":{"prompt_tokens":5,"completion_tokens":0,"prompt_tokens_details":{"cached_tokens":3,"cache_write_tokens":2}}}`) + "data: [DONE]"},
+		{ensemble.Gemini, `{"modelVersion":"resolved","candidates":[{"content":{"parts":[{"text":"plan","thought":true,"thoughtSignature":"private-signature"},{"text":"hello"},{"functionCall":{"id":"c","name":"lookup","args":{"q":"x"}},"thoughtSignature":"call-signature"}]}}],"usageMetadata":{"promptTokenCount":3,"cachedContentTokenCount":3,"candidatesTokenCount":0,"thoughtsTokenCount":2}}`, frame(`{"modelVersion":"resolved","candidates":[{"content":{"parts":[{"text":"plan","thought":true,"thoughtSignature":"private-signature"},{"text":"he"}]}}]}`) + frame(`{"candidates":[{"content":{"parts":[{"text":"llo"},{"functionCall":{"id":"c","name":"lookup","args":{"q":"x"}},"thoughtSignature":"call-signature"}]},"finishReason":"STOP"}],"usageMetadata":{"promptTokenCount":3,"cachedContentTokenCount":3,"candidatesTokenCount":0,"thoughtsTokenCount":2}}`)},
+	}
+}
+func streamAgent(t *testing.T, v ensemble.Vendor, url string, disable bool, explain bool) (*ensemble.Ensemble, ensemble.Agent) {
+	t.Helper()
+	root := ensemble.New(log.New(io.Discard, "", 0))
+	t.Cleanup(func() { _ = root.Shutdown() })
+	a, err := root.NewAgent(ensemble.Config{Vendor: v, Model: map[ensemble.Vendor]string{ensemble.Anthropic: "claude-sonnet-4-6", ensemble.OpenAI: "gpt-4.1-2025-04-14", ensemble.Gemini: "gemini-3.8-flash"}[v], BaseURL: url, APIKey: "fixture-key", System: "test", MaxTokens: 512, EnableTools: true, DisableStreaming: disable, RequireToolExplanation: explain, HistoryPath: filepath.Join(t.TempDir(), "history.jsonl")})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return root, a
+}
+func parse6(a ensemble.Agent, body, typ string, cb ensemble.StreamCallbacks) error {
+	return a.Engine().Parse(&http.Response{StatusCode: 200, Header: http.Header{"Content-Type": []string{typ}}, Body: io.NopCloser(strings.NewReader(body))}, cb)
+}
+func normal6(v any) any {
+	b, _ := json.Marshal(v)
+	var out any
+	_ = json.Unmarshal(b, &out)
+	return out
+}
+func TestChapter6PlainStreamParity(t *testing.T) {
+	for _, f := range fixtures6() {
+		t.Run(f.vendor.String(), func(t *testing.T) {
+			_, a := streamAgent(t, f.vendor, "http://unused.invalid", false, false)
+			var plain, stream ensemble.ResponseEvent
+			var ids []uint64
+			seen := map[uint64]bool{}
+			deltas := map[ensemble.DeltaKind]string{}
+			frames := 0
+			if err := parse6(a, f.plain, "application/json", ensemble.StreamCallbacks{OnEvent: func(e ensemble.Event) { plain = *e.Response }}); err != nil {
+				t.Fatal(err)
+			}
+			err := parse6(a, f.stream, "text/event-stream; charset=utf-8", ensemble.StreamCallbacks{OnEvent: func(e ensemble.Event) { stream = *e.Response }, OnDelta: func(id uint64, k ensemble.DeltaKind, s string) { seen[id] = true; deltas[k] += s }, OnPartFinal: func(id uint64, p ensemble.Part) { ids = append(ids, id) }, OnFrame: func(_ string, _ []byte) { frames++ }})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !reflect.DeepEqual(normal6(plain), normal6(stream)) {
+				t.Fatalf("parity\nplain=%s\nstream=%s", must6(plain), must6(stream))
+			}
+			if len(ids) != 3 || frames < 2 || !seen[0] {
+				t.Fatalf("ids=%v seen=%v frames=%d", ids, seen, frames)
+			}
+			for _, id := range ids {
+				if !seen[id] {
+					t.Fatalf("final ID %d not in deltas", id)
+				}
+			}
+			if deltas[ensemble.DeltaText] != "hello" || deltas[ensemble.DeltaThinking] != "plan" || !strings.Contains(deltas[ensemble.DeltaToolCall], "lookup") {
+				t.Fatal(deltas)
+			}
+			if strings.Contains(deltas[ensemble.DeltaThinking], "signature") {
+				t.Fatal("signature leaked")
+			}
+		})
+	}
+}
+func must6(v any) string { b, _ := json.Marshal(v); return string(b) }
+func TestChapter6DelayedPublicProgressAndReset(t *testing.T) {
+	release := make(chan struct{})
+	var once sync.Once
+	defer once.Do(func() { close(release) })
+	var calls atomic.Int32
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		n := calls.Add(1)
+		w.Header().Set("Content-Type", "text/event-stream")
+		fmt.Fprint(w, anthStart()+anthBlock(0, "text", "early"))
+		w.(http.Flusher).Flush()
+		if n == 1 {
+			select {
+			case <-release:
+			case <-r.Context().Done():
+				return
+			}
+		}
+		fmt.Fprint(w, anthStop(0)+anthEnd())
+	}))
+	defer srv.Close()
+	defer once.Do(func() { close(release) })
+	root, a := streamAgent(t, ensemble.Anthropic, srv.URL, false, false)
+	progress := make(chan ensemble.PartDelta, 8)
+	finals := make(chan ensemble.PartFinal, 8)
+	a.Observe(func(e ensemble.HubEvent) {
+		switch v := e.(type) {
+		case ensemble.PartDelta:
+			progress <- v
+		case ensemble.PartFinal:
+			finals <- v
+		}
+	})
+	reply := a.Submit(context.Background(), "one")
+	var first ensemble.PartDelta
+	select {
+	case first = <-progress:
+	case <-time.After(3 * time.Second):
+		t.Fatal("no incremental progress")
+	}
+	if first.PartID != 0 || first.Chunk != "early" {
+		t.Fatal(first)
+	}
+	select {
+	case <-reply:
+		t.Fatal("completed before body released")
+	default:
+	}
+	for _, e := range a.Log().Events() {
+		if e.Type == "response_ended" {
+			t.Fatal("partial response entered history")
+		}
+	}
+	once.Do(func() { close(release) })
+	if r := <-reply; r.Err != nil || r.Text != "early" {
+		t.Fatal(r)
+	}
+	f := <-finals
+	if f.PartID != first.PartID || f.Response != first.Response {
+		t.Fatal("identity replaced")
+	}
+	if _, err := a.Ask(context.Background(), "two"); err != nil {
+		t.Fatal(err)
+	}
+	next := <-progress
+	if next.PartID != 0 || next.Response == first.Response {
+		t.Fatal("response boundary missing")
+	}
+	_ = root.Shutdown()
+	data, err := json.Marshal(a.Log().Events())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if bytes.Contains(data, []byte("part_delta")) || bytes.Contains(data, []byte("part_id")) {
+		t.Fatal("transport persisted")
+	}
+}
