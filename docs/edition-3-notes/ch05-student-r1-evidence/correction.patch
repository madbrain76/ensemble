+// Held boundaries are released even when original production fails an assertion.
+func releaseOnce() (chan struct{}, func()) {
+	ch := make(chan struct{})
+	var once sync.Once
+	return ch, func() { once.Do(func() { close(ch) }) }
+}
+
+func TestChapter5CorrectionR1TextOnlyHintContinuation(t *testing.T) {
+	entered, continuing := make(chan struct{}), make(chan struct{})
+	release, unblock := releaseOnce()
+	finish, finishContinuation := releaseOnce()
+	payloads := make(chan string, 4)
+	var requests atomic.Int32
+	const hint = "R1_ADMITTED_HINT_7e8c"
+	a, _ := actorFixture(t, func(w http.ResponseWriter, r *http.Request) {
+		raw, _ := io.ReadAll(r.Body)
+		payloads <- string(raw)
+		switch requests.Add(1) {
+		case 1:
+			close(entered)
+			<-release
+			json.NewEncoder(w).Encode(providerReply(ensemble.Anthropic, []ensemble.Part{prose("initial text")}))
+		case 2:
+			close(continuing)
+			<-finish
+			json.NewEncoder(w).Encode(providerReply(ensemble.Anthropic, []ensemble.Part{prose("hint handled")}))
+		default:
+			json.NewEncoder(w).Encode(providerReply(ensemble.Anthropic, []ensemble.Part{prose("unrelated reply")}))
+		}
+	}, func(c *ensemble.Config) { c.ToolBatchLimit = 1 })
+	t.Cleanup(func() { unblock(); finishContinuation() })
+	reply := a.Submit(context.Background(), "initial prompt")
+	<-entered
+	if err := a.Post(ensemble.Hint{Text: hint}); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	if _, err := a.Wait(ctx, func(o ensemble.Observation) bool {
+		p, ok := o.(ensemble.PartDelta)
+		return ok && p.Chunk == "hint: "+hint
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if first := <-payloads; strings.Contains(first, hint) {
+		t.Fatal("R1 hint mutated already-sent HTTP bytes")
+	}
+	unblock()
+	select {
+	case <-continuing:
+	case result := <-reply:
+		t.Fatalf("R1 successful text-only turn stranded its acknowledged hint: %+v", result)
+	case <-time.After(2 * time.Second):
+		t.Fatal("R1 no same-turn continuation for acknowledged hint")
+	}
+	select {
+	case result := <-reply:
+		t.Fatalf("R1 reply preceded hint continuation: %+v", result)
+	default:
+	}
+	if next := <-payloads; strings.Count(next, hint) != 1 {
+		t.Fatalf("R1 hint not consumed exactly once: %s", next)
+	}
+	finishContinuation()
+	if result := wait5(t, reply); result.Err != nil || result.Text != "hint handled" {
+		t.Fatal(result)
+	}
+	if len(a.Log().Context().Ephemera) != 0 {
+		t.Fatal("R1 pending hint survived successful completion")
+	}
+	saved, err := os.ReadFile(a.Config().HistoryPath)
+	if err != nil || !bytes.Contains(saved, []byte("hint handled")) || !bytes.Contains(saved, []byte(`"type":"turn_ended"`)) {
+		t.Fatalf("R1 continuation success not saved: %v", err)
+	}
+	if text, err := a.Ask(context.Background(), "unrelated prompt"); err != nil || text != "unrelated reply" {
+		t.Fatalf("%q %v", text, err)
+	}
+	if later := <-payloads; strings.Contains(later, hint) {
+		t.Fatal("R1 hint leaked into unrelated prompt")
+	}
+	if requests.Load() != 3 {
+		t.Fatalf("R1 wrong request count: %d", requests.Load())
+	}
+}
