+func TestChapter5CorrectionR3StopProcessesBeforeGoJoin(t *testing.T) {
+	// Repeated real layouts cover the old map-order-dependent defect without
+	// replacing map iteration or mocking process cleanup. Every round holds all
+	// ordinary handlers until the managed process has actually been reaped.
+	for round := 0; round < 8; round++ {
+		t.Run(strconv.Itoa(round), func(t *testing.T) {
+			a, root := actorFixture(t, func(w http.ResponseWriter, r *http.Request) {
+				t.Error("R3 direct tools unexpectedly invoked model")
+				http.Error(w, "unexpected", 500)
+			}, func(c *ensemble.Config) { c.EnableTools = true })
+			release, unblock := releaseOnce()
+			shutdown := make(chan struct{})
+			var shutdownErr error
+			stopping := false
+			t.Cleanup(func() {
+				unblock()
+				if stopping {
+					select {
+					case <-shutdown:
+					case <-time.After(3 * time.Second):
+						t.Error("R3 shutdown failed to join after release")
+					}
+				}
+			})
+			type held struct {
+				job    ensemble.Job
+				agent  ensemble.Agent
+				output string
+			}
+			started := make(chan held, 4)
+			for n := 0; n < 4; n++ {
+				cfg := a.Config()
+				cfg.HistoryPath = filepath.Join(t.TempDir(), "ordinary.jsonl")
+				owner, err := root.NewAgent(cfg)
+				if err != nil {
+					t.Fatal(err)
+				}
+				output := fmt.Sprintf("R3_REAL_GO_RESULT_%d", n)
+				if err := owner.RegisterTool(ensemble.ToolDefinition{Name: "ordinary_hold", Description: "held ordinary handler", Parameters: json.RawMessage(`{"type":"object"}`)}, func(tc ensemble.ToolContext, _ json.RawMessage) (string, error) {
+					started <- held{tc.Job, tc.Agent, output}
+					<-release
+					return output, nil
+				}); err != nil {
+					t.Fatal(err)
+				}
+				go func() { _, _ = owner.CallTool(context.Background(), "ordinary_hold", json.RawMessage(`{}`)) }()
+			}
+			var heldJobs []held
+			for n := 0; n < 4; n++ {
+				select {
+				case h := <-started:
+					heldJobs = append(heldJobs, h)
+				case <-time.After(2 * time.Second):
+					t.Fatal("R3 ordinary handler did not start")
+				}
+			}
+			if _, err := a.CallTool(context.Background(), "tool_limits", json.RawMessage(`{"ai_callback_delay":0.01}`)); err != nil {
+				t.Fatal(err)
+			}
+			pidfile := filepath.Join(a.Config().DataDir, "managed.pid")
+			args, _ := json.Marshal(map[string]string{"command": fmt.Sprintf("printf '%%s\\n' \"$$\" > %q; printf 'R3_READY\\n'; exec sleep 30", pidfile)})
+			report, err := a.CallTool(context.Background(), "run_command", args)
+			if err != nil {
+				t.Fatal(err)
+			}
+			handle := 0
+			for _, event := range a.Log().Events() {
+				if event.Type == "tool_called" && event.Tool != nil && event.Tool.Name == "run_command" && event.Tool.Job != nil {
+					handle = event.Tool.Job.Handle
+				}
+			}
+			if handle == 0 {
+				t.Fatalf("R3 missing real process handle: %s", report)
+			}
+			process, err := root.Jobs().Get(handle)
+			if err != nil {
+				t.Fatal(err)
+			}
+			var pid int
+			deadline := time.Now().Add(2 * time.Second)
+			for time.Now().Before(deadline) {
+				raw, e := os.ReadFile(pidfile)
+				if e == nil {
+					pid, _ = strconv.Atoi(strings.TrimSpace(string(raw)))
+				}
+				output, _ := os.ReadFile(filepath.Join(a.Config().DataDir, process.Snapshot().Output.Locator))
+				if pid > 0 && bytes.Contains(output, []byte("R3_READY")) {
+					break
+				}
+				time.Sleep(5 * time.Millisecond)
+			}
+			if pid <= 0 || syscall.Kill(pid, 0) != nil {
+				t.Fatal("R3 process not actually ready/alive")
+			}
+			stopping = true
+			go func() { shutdownErr = root.Shutdown(); close(shutdown) }()
+			select {
+			case <-process.Done():
+			case <-time.After(1500 * time.Millisecond):
+				t.Fatalf("R3 managed process cleanup blocked behind ordinary Go handler; actual process alive=%t", syscall.Kill(pid, 0) == nil)
+			}
+			if err := syscall.Kill(pid, 0); !errors.Is(err, syscall.ESRCH) {
+				t.Fatalf("R3 process was labeled stopped but not actually reaped: %v", err)
+			}
+			select {
+			case <-shutdown:
+				t.Fatal("R3 shutdown fabricated ordinary-handler completion")
+			default:
+			}
+			unblock()
+			select {
+			case <-shutdown:
+			case <-time.After(3 * time.Second):
+				t.Fatal("R3 shutdown did not join actual ordinary results")
+			}
+			if shutdownErr != nil {
+				t.Fatal(shutdownErr)
+			}
+			for _, h := range heldJobs {
+				record := h.job.Snapshot()
+				raw, err := os.ReadFile(filepath.Join(h.agent.Config().DataDir, record.Output.Locator))
+				if err != nil || record.Status != "done" || !bytes.Contains(raw, []byte(h.output)) {
+					t.Fatalf("R3 true ordinary result lost: %+v %q %v", record, raw, err)
+				}
+				saved, err := os.ReadFile(h.agent.Config().HistoryPath)
+				if err != nil {
+					t.Fatal(err)
+				}
+				found := false
+				for _, line := range bytes.Split(saved, []byte("\n")) {
+					var event ensemble.Event
+					if json.Unmarshal(line, &event) == nil && event.Type == "job_report" && event.Job != nil && event.Job.Handle == record.Handle && event.Job.Status == "done" {
+						found = true
+					}
+				}
+				if !found {
+					t.Fatalf("R3 final save lacks true job report for %d", record.Handle)
+				}
+			}
+		})
+	}
+}
