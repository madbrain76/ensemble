+func TestChapter5CorrectionR2BufferedDurableCompletion(t *testing.T) {
+	var requests atomic.Int32
+	a, root := actorFixture(t, func(w http.ResponseWriter, r *http.Request) {
+		requests.Add(1)
+		json.NewEncoder(w).Encode(providerReply(ensemble.Anthropic, []ensemble.Part{prose("durable buffered result")}))
+	}, nil)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	reply := a.Submit(ctx, "caller need not wait")
+	barrier, stop := context.WithTimeout(context.Background(), 2*time.Second)
+	defer stop()
+	if err := a.Drain(barrier); err != nil {
+		t.Fatal("R2 abandoned waiter blocked actor completion:", err)
+	}
+	saved, err := os.ReadFile(a.Config().HistoryPath)
+	if err != nil || !bytes.Contains(saved, []byte("durable buffered result")) {
+		t.Fatal("R2 result not saved before completion", err)
+	}
+	cancel()
+	if err := root.Shutdown(); err != nil {
+		t.Fatal(err)
+	}
+	if result := wait5(t, reply); result.Err != nil || result.Text != "durable buffered result" {
+		t.Fatalf("R2 lost already-completed durable reply: %+v", result)
+	}
+	if _, err := a.Ask(nil, "after stop"); !errors.Is(err, ensemble.ErrStopped) {
+		t.Fatalf("R2 shutdown observation confused with success: %v", err)
+	}
+	if requests.Load() != 1 {
+		t.Fatal("R2 stopped Ask reached HTTP")
+	}
+}
