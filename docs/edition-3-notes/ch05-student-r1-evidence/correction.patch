+func TestChapter5CorrectionR2AskCancellationWhileOtherRequestHeld(t *testing.T) {
+	for _, already := range []bool{true, false} {
+		t.Run(fmt.Sprintf("already-cancelled-%t", already), func(t *testing.T) {
+			entered := make(chan struct{})
+			release, unblock := releaseOnce()
+			var requests atomic.Int32
+			var cancelledPromptSent atomic.Bool
+			a, _ := actorFixture(t, func(w http.ResponseWriter, r *http.Request) {
+				raw, _ := io.ReadAll(r.Body)
+				if bytes.Contains(raw, []byte("R2_CANCELLED")) {
+					cancelledPromptSent.Store(true)
+				}
+				if requests.Add(1) == 1 {
+					close(entered)
+					<-release
+				}
+				json.NewEncoder(w).Encode(providerReply(ensemble.Anthropic, []ensemble.Part{prose("reply:" + latestUserText(raw))}))
+			}, nil)
+			t.Cleanup(unblock)
+			active := a.Submit(context.Background(), "R2_ACTIVE")
+			<-entered
+			parent, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			ctx := &observedCancellation{Context: parent, observed: make(chan struct{})}
+			if already {
+				cancel()
+			}
+			cancelled := make(chan ensemble.Result, 1)
+			go func() { text, err := a.Ask(ctx, "R2_CANCELLED"); cancelled <- ensemble.Result{Text: text, Err: err} }()
+			if !already {
+				// On the original implementation this observation never arrives. Still
+				// cancel and test the caller's behavior, rather than counting a setup timeout.
+				select {
+				case <-ctx.observed:
+				case <-time.After(200 * time.Millisecond):
+				}
+				cancel()
+			}
+			select {
+			case result := <-cancelled:
+				if !errors.Is(result.Err, context.Canceled) || result.Text != "" {
+					t.Fatalf("R2 wrong private cancelled result: %+v", result)
+				}
+			case <-time.After(time.Second):
+				t.Fatal("R2 cancelled Ask blocked on unrelated held request")
+			}
+			select {
+			case <-active:
+				t.Fatal("R2 test lost held-request boundary")
+			default:
+			}
+			if requests.Load() != 1 {
+				t.Fatal("R2 cancelled queued request reached HTTP")
+			}
+			unblock()
+			if result := wait5(t, active); result.Err != nil || result.Text != "reply:R2_ACTIVE" {
+				t.Fatalf("R2 stole active reply: %+v", result)
+			}
+			var callers sync.WaitGroup
+			for _, name := range []string{"R2_LATER_A", "R2_LATER_B"} {
+				callers.Add(1)
+				go func(name string) {
+					defer callers.Done()
+					text, err := a.Ask(context.Background(), name)
+					if err != nil || text != "reply:"+name {
+						t.Errorf("R2 isolated reply %s: %q %v", name, text, err)
+					}
+				}(name)
+			}
+			callers.Wait()
+			if cancelledPromptSent.Load() || requests.Load() != 3 {
+				t.Fatalf("R2 cancelled request leaked or replies blocked: requests=%d", requests.Load())
+			}
+			saved, err := os.ReadFile(a.Config().HistoryPath)
+			if err != nil || !bytes.Contains(saved, []byte("reply:R2_LATER_A")) || !bytes.Contains(saved, []byte("reply:R2_LATER_B")) {
+				t.Fatalf("R2 successful replies were not durably isolated: %v", err)
+			}
+		})
+	}
+}
