+// This wraps an actual cancellable context, not a replaced Agent function. The
+// access signal establishes that corrected Ask has admitted the queued request
+// and begun waiting. Original Ask never consults Done while unrelated work holds.
+type observedCancellation struct {
+	context.Context
+	observed chan struct{}
+	once     sync.Once
+}
+
+func (c *observedCancellation) Done() <-chan struct{} {
+	c.once.Do(func() { close(c.observed) })
+	return c.Context.Done()
+}
+
+func latestUserText(raw []byte) string {
+	var body struct {
+		Messages []struct {
+			Role    string
+			Content json.RawMessage
+		}
+	}
+	if json.Unmarshal(raw, &body) != nil {
+		return "invalid request"
+	}
+	for i := len(body.Messages) - 1; i >= 0; i-- {
+		if body.Messages[i].Role != "user" {
+			continue
+		}
+		var parts []struct{ Text string }
+		if json.Unmarshal(body.Messages[i].Content, &parts) != nil {
+			return "invalid content"
+		}
+		var text strings.Builder
+		for _, part := range parts {
+			text.WriteString(part.Text)
+		}
+		return text.String()
+	}
+	return "missing user"
+}
