 			return
 		}
+		// An admitted hint cannot change the request that produced this response.
+		// Consume it in this turn's next immutable snapshot before claiming success.
+		if len(a.history.Context().Ephemera) > 0 {
+			a.sendModel()
+			return
+		}
 		a.end(nil)
 		return
 	}
